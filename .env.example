# Copy to .env and fill in secrets before running docker-compose.
# Never commit .env to version control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=localdevpassword
AUTH_SERVICE_DB_PASSWORD=auth_service_password
PROFILE_SERVICE_DB_PASSWORD=profile_service_password
ORG_SERVICE_DB_PASSWORD=org_service_password
CONTENT_SERVICE_DB_PASSWORD=content_service_password
MEDIA_SERVICE_DB_PASSWORD=media_service_password
NOTIFICATIONS_SERVICE_DB_PASSWORD=notifications_service_password
LEARNING_SERVICE_DB_PASSWORD=learning_service_password
EXERCISE_ENGINE_SERVICE_DB_PASSWORD=exercise_engine_service_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=localdevpassword

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_PASSWORD=localdevpassword

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Auth Service ──────────────────────────────────────────────────────────────
# MFA challenge token signing secret — minimum 32 characters
MFA_CHALLENGE_SECRET=local-dev-secret-must-be-at-least-32-characters
# AES-256-GCM key for TOTP secret encryption — base64-encoded 32 bytes
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── JWT public key (mounted into all services that verify tokens) ─────────────
# Paste the one-liner form: -----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY=

# ── Internal service token (service-to-service calls) ────────────────────────
INTERNAL_SERVICE_TOKEN=internal-dev-token

# ── Frontend base URL (used in email links) ───────────────────────────────────
APP_BASE_URL=http://localhost:3000
