# SSZ Platform — Local Development Environment Template
# Copy this file to .env and fill in the values.

# ── Compose file merging ────────────────────────────────────────────────────
# Determines which compose files are merged when running docker compose.
# For dev (default):
COMPOSE_FILE=docker-compose.base.yml:docker-compose.dev.yml
# For prod use a separate .env.prod file with:
# COMPOSE_FILE=docker-compose.base.yml:docker-compose.prod.yml

# ── Infrastructure ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Origin browsers reach MinIO at; presigned links are signed for it (prod only — dev defaults to http://localhost:9000).
MINIO_PUBLIC_BASE_URL=

# ── Auth Service ────────────────────────────────────────────────────────────
MFA_CHALLENGE_SECRET=
TOTP_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:3000

# ── JWT Public Key ──────────────────────────────────────────────────────────
# Generate from: awk 'NF {printf "%s\\n", $0}' services/auth-service/keys/jwt_public_key.pem
# Paste the single-line output here (newlines escaped as \n).
JWT_PUBLIC_KEY=

# ── Service DB passwords ────────────────────────────────────────────────────
AUTH_SERVICE_DB_PASSWORD=
PROFILE_SERVICE_DB_PASSWORD=
ORG_SERVICE_DB_PASSWORD=
CONTENT_SERVICE_DB_PASSWORD=
MEDIA_SERVICE_DB_PASSWORD=
NOTIFICATIONS_SERVICE_DB_PASSWORD=
LEARNING_SERVICE_DB_PASSWORD=
EXERCISE_ENGINE_SERVICE_DB_PASSWORD=
ANALYTICS_SERVICE_DB_PASSWORD=
SCHEDULING_SERVICE_DB_PASSWORD=
AI_SERVICE_DB_PASSWORD=
SUBSCRIPTION_SERVICE_DB_PASSWORD=

# ── Internal tokens ─────────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=

# ── Organization Service ────────────────────────────────────────────────────
# Signs tutor invitation links (min 32 chars). Rotating it voids pending invitations.
INVITATION_JWT_SECRET=

# ── AI Service: provider keys ───────────────────────────────────────────────
# Optional. Each provider in the registry names its variable (credentialRef);
# an empty one leaves that provider `configured: false` and nothing else breaks.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
