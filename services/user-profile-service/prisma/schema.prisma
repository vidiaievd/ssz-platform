generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  displayName         String
  firstName           String?
  lastName            String?
  avatarUrl           String?
  bio                 String?   @db.Text
  timezone            String    @default("UTC")
  uiLocale            String    @default("en") @map("locale")
  guardianAccountId   String?   @map("guardian_account_id")
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  languagesOfInterest String[]  @default([]) @map("languages_of_interest")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  studentProfile  StudentProfile?
  tutorProfile    TutorProfile?
  teachingProfile TeachingProfile?

  @@map("profiles")
}

model StudentProfile {
  id              String                  @id @default(uuid())
  profileId       String                  @unique
  profile         Profile                 @relation(fields: [profileId], references: [id])
  nativeLanguage  String?
  targetLanguages StudentTargetLanguage[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("student_profiles")
}

model StudentTargetLanguage {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  languageCode     String
  level            String?        // CEFR: A1 | A2 | B1 | B2 | C1 | C2
  createdAt        DateTime       @default(now())

  @@unique([studentProfileId, languageCode])
  @@map("student_target_languages")
}

model TutorProfile {
  id                String                 @id @default(uuid())
  profileId         String                 @unique
  profile           Profile                @relation(fields: [profileId], references: [id])
  hourlyRate        Decimal?               @db.Decimal(10, 2)
  yearsOfExperience Int?
  teachingLanguages TutorTeachingLanguage[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("tutor_profiles")
}

model TutorTeachingLanguage {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])
  languageCode   String
  proficiency    String       // NATIVE | FLUENT | ADVANCED | INTERMEDIATE
  createdAt      DateTime     @default(now())

  @@unique([tutorProfileId, languageCode])
  @@map("tutor_teaching_languages")
}

model TeachingProfile {
  id        String            @id @default(uuid())
  profileId String            @unique @map("profile_id")
  profile   Profile           @relation(fields: [profileId], references: [id])
  languages TeachingLanguage[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("teaching_profiles")
}

model TeachingLanguage {
  id                String          @id @default(uuid())
  teachingProfileId String          @map("teaching_profile_id")
  teachingProfile   TeachingProfile @relation(fields: [teachingProfileId], references: [id])
  code              String          @db.Char(2)
  level             String?         // CEFR A1–C2
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([teachingProfileId, code])
  @@map("teaching_languages")
}

enum PlacementScope {
  platform
  membership

  @@map("placement_scope")
}

model PlacementResult {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  language     String         @db.Char(2)
  cefrLevel    String         @map("cefr_level")
  score        Int
  scope        PlacementScope
  membershipId String?        @map("membership_id")
  sourceLabel  String         @map("source_label")
  takenAt      DateTime       @map("taken_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([userId, language, scope])
  @@index([userId])
  @@map("placement_results")
}

// Projection: userId → email + roles, built from auth.user.registered events.
// Used exclusively for the internal email-lookup endpoint (school admin / invite flow).
model UserEmailIndex {
  userId    String   @id @map("user_id")
  email     String   @unique
  roles     String[] // e.g. ["student", "tutor"]
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_email_index")
}

// Stores IDs of already-processed RabbitMQ events.
// Checked before handling any incoming event to guarantee idempotency —
// duplicate deliveries are silently ignored.
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}
