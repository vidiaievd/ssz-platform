# Database
DB_PASSWORD=your_password_here

# JWT — generated by script  generate-keys.sh
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem

# AES-256 TOTP encryption key (base64, 32 байта)
TOTP_ENCRYPTION_KEY_BASE64=

# Secret for MFA challenge tokens (minimum 32 characters)
MFA_CHALLENGE_SECRET=

# Redis
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_PASSWORD=

# Environment: Development | Production
ASPNETCORE_ENVIRONMENT=Development