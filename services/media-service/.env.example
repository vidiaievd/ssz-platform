# Application
NODE_ENV=development
PORT=3004
LOG_LEVEL=debug

# Database
DATABASE_URL="postgresql://media_service:media_service_password@localhost:5432/media_db?schema=public"

# RabbitMQ
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672
RABBITMQ_EXCHANGE=ssz.events

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword
REDIS_KEY_PREFIX=media:

# JWT (RS256 public key from Auth Service — replace \n with literal newline in production)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://auth.ssz-platform.internal"
JWT_AUDIENCE="ssz-services"

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=ssz-public
MINIO_BUCKET_PRIVATE=ssz-private

# Upload limits
PRESIGNED_UPLOAD_TTL_SECONDS=900
PRESIGNED_DOWNLOAD_TTL_SECONDS=3600
MAX_IMAGE_SIZE_BYTES=20971520
MAX_AUDIO_SIZE_BYTES=104857600
MAX_VIDEO_SIZE_BYTES=524288000
