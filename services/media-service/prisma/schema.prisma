generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED

  @@map("asset_status")
}

// Where an asset's bytes came from (plan 74): uploaded by a person or produced by speech
// synthesis. Member names equal the stored values, so no @map sits between them.
enum AssetOrigin {
  UPLOAD
  SYNTHESIZED

  @@map("asset_origin")
}

enum ProcessingJobType {
  IMAGE_RESIZE
  AUDIO_CONVERT
  VIDEO_TRANSCODE
  SPEECH_SYNTHESIS

  @@map("processing_job_type")
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@map("processing_job_status")
}

model MediaAsset {
  id               String      @id @default(uuid())
  ownerId          String      @map("owner_id")
  entityType       String?     @map("entity_type")
  entityId         String?     @map("entity_id")
  mimeType         String      @map("mime_type")
  sizeBytes        BigInt      @map("size_bytes")
  storageKey       String      @unique @map("storage_key")
  originalFilename String?     @map("original_filename")
  status           AssetStatus @default(PENDING_UPLOAD)
  uploadedAt       DateTime?   @map("uploaded_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  // Audio only (plan 70): measured length and the normalised waveform.
  durationMs       Int?        @map("duration_ms")
  peaks            Json?
  // Plan 74: how the bytes were made; `synthesis` holds provider, voice, lang, textHash.
  origin           AssetOrigin @default(UPLOAD)
  synthesis        Json?
  // Plan 74 D5: a narration replaced by another stays playable until the retention ends.
  supersededAt     DateTime?   @map("superseded_at")
  supersededBy     String?     @map("superseded_by")

  variants AssetVariant[]
  jobs     ProcessingJob[]

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("media_assets")
}

model AssetVariant {
  id          String   @id @default(uuid())
  assetId     String   @map("asset_id")
  variantType String   @map("variant_type")
  storageKey  String   @unique @map("storage_key")
  mimeType    String   @map("mime_type")
  sizeBytes   BigInt   @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  asset MediaAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_variants")
}

model ProcessingJob {
  id          String              @id @default(uuid())
  assetId     String              @map("asset_id")
  type        ProcessingJobType
  status      ProcessingJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error")
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  asset MediaAsset @relation(fields: [assetId], references: [id])

  @@index([status])
  @@map("processing_jobs")
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

// Plan 90, phase 8, step 3: one row per run of a media sweep — nightly, from the admin panel or
// by an operator. `kind` / `mode` / `trigger` are checked by the domain (`sweep-run.ts`); kept 90 days.
model SweepRun {
  id         String    @id @default(uuid())
  kind       String
  mode       String
  trigger    String
  actorId    String?   @map("actor_id")
  // The sweep's own report, as it returned it (its shape depends on `kind`).
  report     Json?
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([kind, startedAt])
  @@index([startedAt])
  @@map("sweep_runs")
}

// ─── Admin trail (plan 90, phase 8, step 4) ──────────────────────────────────

/// Every change a platform admin makes here (a sweep run in delete mode), written together with its
/// `admin.action.performed` outbox row; analytics files it into the shared journal.
model AdminAudit {
  /// = the event's `eventId`.
  id         String   @id
  occurredAt DateTime @map("occurred_at")
  actorId    String   @map("actor_id")
  actorLevel String   @map("actor_level") @db.VarChar(16)
  /// `<object>.<verb>`, e.g. `media.sweep.deleted`.
  action     String   @db.VarChar(64)
  /// `media_sweep` — a sweep by its kind.
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   String   @map("target_id") @db.VarChar(128)
  reason     String   @db.VarChar(500)
  before     Json?
  after      Json?

  @@index([occurredAt], map: "admin_audit_occurred_at_idx")
  @@index([targetType, targetId], map: "admin_audit_target_idx")
  @@map("admin_audit")
}

/// Events waiting for the relay (`@ssz/messaging`): written in the same transaction as their cause.
model Outbox {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String    @db.Text
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
