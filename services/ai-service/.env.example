# ─── Application ──────────────────────────────────────────────────────────────
PORT=3010
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ai_service:localdevpassword@localhost:5432/ai_db?schema=public"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://auth.ssz-platform.internal"
JWT_AUDIENCE="ssz-services"

# ─── Service-to-service ───────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=change-me-in-prod
