# Application
NODE_ENV=development
PORT=3007
LOG_LEVEL=debug

# Database (PostgreSQL — learning_db)
DATABASE_URL=postgresql://learning_service:learning_service_password@localhost:5432/learning_db

# RabbitMQ
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672
RABBITMQ_EXCHANGE=ssz.events

# Redis (used for BullMQ job queues and container-completion cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword
REDIS_DB=4
REDIS_KEY_PREFIX=learning:

# JWT — RS256 public key from Auth Service.
# Paste the PEM inline with literal \n in place of real newlines.
JWT_PUBLIC_KEY=
# Or provide a path to the .pem file:
# JWT_PUBLIC_KEY_PATH=./keys/jwt_public_key.pem
JWT_ISSUER=https://auth.ssz-platform.internal
JWT_AUDIENCE=ssz-services

# Content Service (internal HTTP)
CONTENT_SERVICE_URL=http://localhost:3003
CONTENT_SERVICE_TIMEOUT_MS=2000
CONTENT_SERVICE_RETRIES=2

# Organization Service (internal HTTP)
ORGANIZATION_SERVICE_URL=http://localhost:3002
ORGANIZATION_SERVICE_TIMEOUT_MS=2000
ORGANIZATION_SERVICE_RETRIES=2

# Shared secret for intra-cluster calls (same value across all services)
INTERNAL_SERVICE_TOKEN=change_me_in_production
