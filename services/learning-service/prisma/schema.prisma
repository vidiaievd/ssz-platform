// Connection URL is configured in prisma.config.ts (Prisma 7).
// Run `npx prisma generate` after schema changes, `npx prisma migrate dev` to apply.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────
// Prisma enum names: SCREAMING_SNAKE_CASE  |  DB values: lowercase via @map

enum ContentType {
  CONTAINER       @map("container")
  LESSON          @map("lesson")
  VOCABULARY_LIST @map("vocabulary_list")
  GRAMMAR_RULE    @map("grammar_rule")
  EXERCISE        @map("exercise")

  @@map("content_type")
}

enum AssignmentStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  OVERDUE   @map("overdue")

  @@map("assignment_status")
}

enum EnrollmentStatus {
  ACTIVE     @map("active")
  COMPLETED  @map("completed")
  UNENROLLED @map("unenrolled")

  @@map("enrollment_status")
}

enum ProgressStatus {
  NOT_STARTED  @map("not_started")
  IN_PROGRESS  @map("in_progress")
  COMPLETED    @map("completed")
  NEEDS_REVIEW @map("needs_review")

  @@map("progress_status")
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Tutor-created assignment of specific content to a student.
// school_id is nullable: required for school-based tutors (MVP), reserved-null for
// future private 1-on-1 tutor relationships (ADR-006).
model Assignment {
  id              String           @id @default(uuid())
  assignerId      String           @map("assigner_id")
  assigneeId      String           @map("assignee_id")
  schoolId        String?          @map("school_id")
  groupId         String?          @map("group_id")
  contentType     ContentType      @map("content_type")
  contentId       String           @map("content_id")
  status          AssignmentStatus @default(ACTIVE)
  assignedAt      DateTime         @default(now()) @map("assigned_at")
  dueAt           DateTime         @map("due_at")
  completedAt     DateTime?        @map("completed_at")
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelledReason String?          @map("cancelled_reason")
  notes           String?
  deletedAt       DateTime?        @map("deleted_at")

  @@index([assigneeId, status])
  @@index([assignerId, status])
  @@index([dueAt, status])
  @@index([contentType, contentId])
  @@map("assignments")
}

// Self-paced enrollment of a student in a container (course/module/collection).
// Only CONTAINER content type is valid here — enforced in the domain layer.
// Unique per (user, container) — cannot enroll twice.
model Enrollment {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  containerId    String           @map("container_id")
  schoolId       String?          @map("school_id")
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  completedAt    DateTime?        @map("completed_at")
  unenrolledAt   DateTime?        @map("unenrolled_at")
  unenrollReason String?          @map("unenroll_reason")
  deletedAt      DateTime?        @map("deleted_at")

  @@unique([userId, containerId])
  @@index([userId, status])
  @@map("enrollments")
}

// One progress record per (user, content item). Unique constraint prevents duplicates.
// score is 0–100 integer. time_spent_seconds is cumulative across all attempts.
model UserProgress {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  contentType      ContentType    @map("content_type")
  contentId        String         @map("content_id")
  status           ProgressStatus @default(NOT_STARTED)
  attemptsCount    Int            @default(0) @map("attempts_count")
  lastAttemptAt    DateTime?      @map("last_attempt_at")
  timeSpentSeconds Int            @default(0) @map("time_spent_seconds")
  score            Int?
  completedAt      DateTime?      @map("completed_at")
  needsReviewSince DateTime?      @map("needs_review_since")
  reviewResolvedAt DateTime?      @map("review_resolved_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([userId, contentType, contentId])
  @@index([userId])
  @@index([contentType, contentId])
  @@map("user_progress")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────
// Transactional outbox: events written here atomically with the domain change.
// OutboxRelayService polls and publishes to RabbitMQ with publisher confirms.
// publishedAt IS NULL means pending. See ADR-011.

model Outbox {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String    @db.Text          // JSON-serialised BaseEvent envelope
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

// RabbitMQ consumer idempotency — one row per processed event.
// Consumers check this table before handling; insert on success.
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

// ─── SRS ──────────────────────────────────────────────────────────────────────

enum SrsContentType {
  EXERCISE        @map("exercise")
  // One gap inside an exercise (plan 36 §C.1). contentId is "<exerciseId>#<gapKey>".
  // Its own type rather than a composite id under EXERCISE, because every existing
  // reader of an EXERCISE card takes contentId for an exercise UUID and fetches it:
  // sharing the type would turn that into a 404 in the runner instead of a branch
  // that has to be written.
  EXERCISE_GAP    @map("exercise_gap")
  VOCABULARY_WORD @map("vocabulary_word")

  @@map("srs_content_type")
}

enum SrsCardState {
  NEW        @map("new")
  LEARNING   @map("learning")
  REVIEW     @map("review")
  RELEARNING @map("relearning")
  SUSPENDED  @map("suspended")

  @@map("srs_card_state")
}

// One card per (user × content item). Unique constraint enforces idempotent introduction.
// FSRS scheduling fields (stability, difficulty, elapsed_days, scheduled_days,
// learning_steps) are opaque to the application layer — only FsrsScheduler reads them.
model SrsReviewCard {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  contentType    SrsContentType @map("content_type")
  contentId      String         @map("content_id")
  state          SrsCardState   @default(NEW) @map("state")
  dueAt          DateTime       @map("due_at")
  stability      Float          @default(0)
  difficulty     Float          @default(0)
  elapsedDays    Float          @default(0) @map("elapsed_days")
  scheduledDays  Int            @default(0) @map("scheduled_days")
  reps           Int            @default(0)
  lapses         Int            @default(0)
  learningSteps  Int            @default(0) @map("learning_steps")
  lastReviewedAt DateTime?      @map("last_reviewed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // (userId, dueAt, state) — the primary query for "what is due now".
  @@index([userId, dueAt, state])
  @@unique([userId, contentType, contentId])
  @@map("srs_review_cards")
}

// ─── Can-do progress (Plan 23 B1.4) ──────────────────────────────────────────
// Tracks per-user achievement of CEFR can-do descriptors from content-service.
// Status is append-only on ACHIEVED: once set, it never reverts on mastery decay.
// selfAssessed is a separate confidence rating updated by the student manually.

enum CanDoStatus {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  ACHIEVED    @map("achieved")

  @@map("can_do_status")
}

// Unique per (userId, descriptorId). achievedAt is sticky — set once and never cleared.
model CanDoProgress {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  descriptorId String      @map("descriptor_id")
  status       CanDoStatus @default(NOT_STARTED) @map("status")
  achievedAt   DateTime?   @map("achieved_at")
  // selfAssessed: null = not self-assessed; true/false = student confidence
  selfAssessed Boolean?    @map("self_assessed")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([userId, descriptorId])
  @@index([userId, status])
  @@map("can_do_progress")
}
