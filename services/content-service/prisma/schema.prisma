generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────
// Prisma enum identifiers are SCREAMING_SNAKE_CASE; DB values are lowercase
// via @map so application code always works with the Prisma representation.

enum ContainerType {
  COURSE     @map("course")
  MODULE     @map("module")
  COLLECTION @map("collection")

  @@map("container_type")
}

// Drives create-time level-section scaffolding on a COURSE container (decision 3
// in plan 29): CEFR/CUSTOM courses get top-level ContainerSections for their levels;
// SINGLE courses stay a flat module list with no level sections.
enum LevelSystem {
  CEFR   @map("cefr")
  CUSTOM @map("custom")
  SINGLE @map("single")

  @@map("level_system")
}

enum GatingMode {
  OPEN       @map("open")
  SEQUENTIAL @map("sequential")

  @@map("gating_mode")
}

enum DifficultyLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("difficulty_level")
}

enum Visibility {
  PUBLIC         @map("public")
  SCHOOL_PRIVATE @map("school_private")
  SHARED         @map("shared")
  PRIVATE        @map("private")

  @@map("visibility")
}

enum AccessTier {
  ASSIGNED_ONLY        @map("assigned_only")
  ENTITLEMENT_REQUIRED @map("entitlement_required")
  FREE_WITHIN_SCHOOL   @map("free_within_school")
  PUBLIC_FREE          @map("public_free")
  PUBLIC_PAID          @map("public_paid")

  @@map("access_tier")
}

enum VersionStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  DEPRECATED @map("deprecated")
  ARCHIVED   @map("archived")

  @@map("version_status")
}

enum ContainerItemType {
  CONTAINER       @map("container")
  LESSON          @map("lesson")
  VOCABULARY_LIST @map("vocabulary_list")
  GRAMMAR_RULE    @map("grammar_rule")
  EXERCISE        @map("exercise")

  @@map("container_item_type")
}

enum VariantStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")

  @@map("variant_status")
}

// Explicit discriminator rather than deriving from media: a TEXT lesson may embed audio
// narration, and video/listening lessons need dedicated composite structures (cues,
// transcript+stages) that hang off the declared kind, not off what media happens to be attached.
enum LessonKind {
  TEXT  @map("text")
  VIDEO @map("video")
  AUDIO @map("audio")
  LIVE  @map("live")

  @@map("lesson_kind")
}

enum ListeningStageType {
  GAP_FILL      @map("gap_fill")
  COMPREHENSION @map("comprehension")

  @@map("listening_stage_type")
}

enum LessonSpanKind {
  VOCAB   @map("vocab")
  GRAMMAR @map("grammar")
  CHUNK   @map("chunk")

  @@map("lesson_span_kind")
}

enum MediaRefType {
  IMAGE @map("image")
  AUDIO @map("audio")
  VIDEO @map("video")

  @@map("media_ref_type")
}

// ─── Models ────────────────────────────────────────────────────────────────

// Container is an "idea" entity — metadata shell around versioned content.
// currentPublishedVersionId is intentionally NOT a Prisma @relation to avoid
// a circular dependency with ContainerVersion. A DEFERRABLE FK is added via
// raw SQL in the follow-up migration (add-container-constraints).
model Container {
  id                        String          @id @default(uuid()) @db.Uuid
  // Partial unique index on (slug) WHERE slug IS NOT NULL AND deleted_at IS NULL
  // is enforced via raw SQL — Prisma does not support partial unique indexes.
  slug                      String?         @db.VarChar(120)
  containerType             ContainerType   @map("container_type")
  targetLanguage            String          @map("target_language") @db.VarChar(10)
  difficultyLevel           DifficultyLevel @map("difficulty_level")
  title                     String          @db.VarChar(200)
  description               String?         @db.Text
  coverImageMediaId         String?         @map("cover_image_media_id") @db.Uuid
  ownerUserId               String          @map("owner_user_id") @db.Uuid
  ownerSchoolId             String?         @map("owner_school_id") @db.Uuid
  visibility                Visibility
  accessTier                AccessTier      @map("access_tier")
  // Only meaningful for containerType=COURSE (decision 3 in plan 29); default CEFR
  // for every existing/new container is harmless on non-course containers.
  levelSystem               LevelSystem     @default(CEFR) @map("level_system")
  // Only meaningful for containerType=COURSE; controls student sub-lesson unlock.
  // Default OPEN keeps every existing course fully unlocked.
  gatingMode                GatingMode      @default(OPEN) @map("gating_mode")
  // How long a learner of THIS course waits for a person to answer their work.
  // Null means the school's own promise applies — the course has not overridden it
  // (plan 44 §44.12). Only meaningful for containerType=COURSE.
  reviewRespondWithinHours  Int?            @map("review_respond_within_hours")
  // Raw FK to container_versions.id (DEFERRABLE INITIALLY DEFERRED) added via migration.
  currentPublishedVersionId String?         @map("current_published_version_id") @db.Uuid
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?       @map("deleted_at") @db.Timestamptz
  archivedAt                DateTime?       @map("archived_at") @db.Timestamptz

  versions      ContainerVersion[]
  localizations ContainerLocalization[]

  @@index([ownerUserId])
  @@index([ownerSchoolId])
  @@index([visibility])
  @@index([targetLanguage, difficultyLevel])
  @@index([deletedAt, visibility, targetLanguage])
  @@map("containers")
}

// One container can have many versions. Only one draft and one published version
// are allowed at a time — enforced via partial unique indexes in raw SQL migration.
model ContainerVersion {
  id                String        @id @default(uuid()) @db.Uuid
  containerId       String        @map("container_id") @db.Uuid
  versionNumber     Int           @map("version_number")
  status            VersionStatus
  changelog         String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz
  publishedByUserId String?       @map("published_by_user_id") @db.Uuid
  deprecatedAt      DateTime?     @map("deprecated_at") @db.Timestamptz
  sunsetAt          DateTime?     @map("sunset_at") @db.Timestamptz
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz
  // Incremented on every item mutation; used for optimistic concurrency on reorder.
  revisionCount     Int           @default(0) @map("revision_count")

  container Container          @relation(fields: [containerId], references: [id])
  items     ContainerItem[]
  sections  ContainerSection[]

  @@unique([containerId, versionNumber])
  @@index([containerId])
  @@index([status, sunsetAt])
  @@map("container_versions")
}

// Named, ordered grouping of items within a version (e.g. CEFR levels / modules).
// Cascade-deleted with the version. Deleting a single section reassigns its items
// to sectionId = null (handled in the application layer), so items are never lost.
model ContainerSection {
  id                 String   @id @default(uuid()) @db.Uuid
  containerVersionId String   @map("container_version_id") @db.Uuid
  title              String   @db.VarChar(100)
  position           Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  containerVersion ContainerVersion @relation(fields: [containerVersionId], references: [id], onDelete: Cascade)
  items            ContainerItem[]

  @@unique([containerVersionId, position])
  @@index([containerVersionId])
  @@map("container_sections")
}

// Ordered list of references inside a version. Position gaps are allowed after
// remove; reorder restores continuous numbering. Cascade-deleted with the version.
model ContainerItem {
  id                 String            @id @default(uuid()) @db.Uuid
  containerVersionId String            @map("container_version_id") @db.Uuid
  position           Int
  itemType           ContainerItemType @map("item_type")
  // Polymorphic reference — no Prisma relation; item_id is validated in application layer.
  itemId             String            @map("item_id") @db.Uuid
  isRequired         Boolean           @default(true) @map("is_required")
  // First-class section grouping. Nullable = ungrouped. Replaces sectionLabel,
  // which is kept one release for back-compat (drop in course-structure-sync Phase E).
  sectionId          String?           @map("section_id") @db.Uuid
  sectionLabel       String?           @map("section_label") @db.VarChar(100)
  // XP awarded to the student on completion. Authored per-item via the inspector;
  // consumed by learning-service progress (content-service does not track XP totals).
  xpReward           Int?              @map("xp_reward")
  addedAt            DateTime          @default(now()) @map("added_at") @db.Timestamptz

  containerVersion ContainerVersion  @relation(fields: [containerVersionId], references: [id], onDelete: Cascade)
  section          ContainerSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([containerVersionId, position])
  @@index([containerVersionId])
  @@index([itemType, itemId])
  @@index([sectionId])
  @@map("container_items")
}

// Optional translated titles/descriptions for containers. One row per language.
model ContainerLocalization {
  id              String   @id @default(uuid()) @db.Uuid
  containerId     String   @map("container_id") @db.Uuid
  languageCode    String   @map("language_code") @db.VarChar(10)
  title           String   @db.VarChar(200)
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdByUserId String   @map("created_by_user_id") @db.Uuid

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@unique([containerId, languageCode])
  @@map("container_localizations")
}

enum PartOfSpeech {
  NOUN         @map("noun")
  VERB         @map("verb")
  ADJECTIVE    @map("adjective")
  ADVERB       @map("adverb")
  PRONOUN      @map("pronoun")
  PREPOSITION  @map("preposition")
  CONJUNCTION  @map("conjunction")
  INTERJECTION @map("interjection")
  NUMERAL      @map("numeral")
  PARTICLE     @map("particle")
  PHRASE       @map("phrase")
  OTHER        @map("other")

  @@map("part_of_speech")
}

enum Register {
  FORMAL     @map("formal")
  INFORMAL   @map("informal")
  NEUTRAL    @map("neutral")
  COLLOQUIAL @map("colloquial")
  SLANG      @map("slang")
  ARCHAIC    @map("archaic")
  DIALECT    @map("dialect")

  @@map("register")
}

// ─── Block 2: Lessons + Content Variants ──────────────────────────────────────

// Lesson is a language-neutral entity — metadata only. All student-facing
// content lives in LessonContentVariant (one per explanation_language × level_range).
// slug is NULL until the first variant is published for a public lesson;
// immutable after that. Partial unique index on slug is added via raw SQL migration.
model Lesson {
  id                  String          @id @default(uuid()) @db.Uuid
  targetLanguage      String          @map("target_language") @db.VarChar(10)
  difficultyLevel     DifficultyLevel @map("difficulty_level")
  // Partial unique index: WHERE slug IS NOT NULL AND deleted_at IS NULL (raw SQL migration).
  slug                String?         @db.VarChar(120)
  title               String          @db.VarChar(200)
  description         String?         @db.Text
  coverImageMediaId   String?         @map("cover_image_media_id") @db.Uuid
  ownerUserId         String          @map("owner_user_id") @db.Uuid
  ownerSchoolId       String?         @map("owner_school_id") @db.Uuid
  // CHECK constraint (raw SQL): owner_school_id IS NULL → visibility ∈ {public,shared,private}
  //                             owner_school_id IS NOT NULL → visibility ∈ {public,school_private,shared,private}
  visibility          Visibility
  kind                LessonKind      @default(TEXT)
  // LIVE-kind stub fields only — minimal reference to an externally-scheduled
  // session. No attendance/recording/approval subsystem (decision 2); full
  // scheduling is organization/learning-service territory, out of scope here.
  liveStartsAt        DateTime?       @map("live_starts_at") @db.Timestamptz
  liveDurationMinutes Int?            @map("live_duration_minutes")
  liveJoinUrl         String?         @map("live_join_url") @db.VarChar(500)
  liveCapacity        Int?            @map("live_capacity")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz

  variants LessonContentVariant[]

  @@index([ownerUserId])
  @@index([ownerSchoolId])
  @@index([visibility])
  @@index([targetLanguage, difficultyLevel])
  @@index([deletedAt, visibility, targetLanguage])
  @@map("lessons")
}

// One variant per (lesson_id, explanation_language, min_level, max_level) combination.
// Silent updates are allowed even when status = published (typo fixes, clarifications).
// deletedAt is set via cascade when the parent lesson is soft-deleted.
// Hard delete is used for direct DELETE /lessons/:id/variants/:vid requests.
model LessonContentVariant {
  id                      String          @id @default(uuid()) @db.Uuid
  lessonId                String          @map("lesson_id") @db.Uuid
  explanationLanguage     String          @map("explanation_language") @db.VarChar(10)
  minLevel                DifficultyLevel @map("min_level")
  maxLevel                DifficultyLevel @map("max_level")
  // CHECK constraint (raw SQL): ordinal(min_level) <= ordinal(max_level) via CASE mapping.
  displayTitle            String          @map("display_title") @db.VarChar(200)
  displayDescription      String?         @map("display_description") @db.Text
  bodyMarkdown            String          @map("body_markdown") @db.Text
  estimatedReadingMinutes Int?            @map("estimated_reading_minutes")
  // Populated only for AUDIO-kind lessons: full transcript of the listening track.
  transcript              String?         @db.Text
  status                  VariantStatus   @default(DRAFT)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdByUserId         String          @map("created_by_user_id") @db.Uuid
  lastEditedByUserId      String          @map("last_edited_by_user_id") @db.Uuid
  publishedAt             DateTime?       @map("published_at") @db.Timestamptz
  // Set via bulk updateMany when parent lesson is soft-deleted.
  deletedAt               DateTime?       @map("deleted_at") @db.Timestamptz

  lesson                Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaRefs             LessonVariantMediaRef[]
  videoCues             LessonVideoCue[]
  videoQuestion         LessonVideoQuestion?
  listeningStages       LessonListeningStage[]
  paragraphTranslations LessonParagraphTranslation[]
  glossaryMarks         LessonVariantGlossaryMark[]
  textSpans             LessonTextSpan[]

  @@unique([lessonId, explanationLanguage, minLevel, maxLevel])
  @@index([lessonId])
  @@index([lessonId, status])
  @@map("lesson_content_variants")
}

// Denormalized table extracted from body_markdown on every save.
// Enables fast reverse lookups: "which lessons use media asset X?"
// Replaced atomically (delete+createMany in a transaction) on every variant save.
model LessonVariantMediaRef {
  id                     String       @id @default(uuid()) @db.Uuid
  lessonContentVariantId String       @map("lesson_content_variant_id") @db.Uuid
  mediaId                String       @map("media_id") @db.Uuid
  mediaType              MediaRefType @map("media_type")
  positionInText         Int          @map("position_in_text")
  extractedAt            DateTime     @map("extracted_at") @db.Timestamptz

  variant LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)

  @@index([lessonContentVariantId])
  @@index([mediaId])
  @@map("lesson_variant_media_refs")
}

// Ordered transcript cues for a VIDEO-kind lesson variant. Powers interactive
// subtitles + synced transcript. position is 0-based within the parent variant.
model LessonVideoCue {
  id                     String   @id @default(uuid()) @db.Uuid
  lessonContentVariantId String   @map("lesson_content_variant_id") @db.Uuid
  position               Int
  startSeconds           Float    @map("start_seconds")
  targetLine             String   @map("target_line") @db.Text
  translationLine        String?  @map("translation_line") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)

  @@unique([lessonContentVariantId, position])
  @@index([lessonContentVariantId])
  @@map("lesson_video_cues")
}

// Ordered gap-fill/comprehension activities staged after a lesson variant's
// primary content: the transcript of an AUDIO lesson, the body of a TEXT one
// (spec 17). Nothing here is medium-specific — kind lives on Lesson, and the
// AUDIO-or-TEXT rule is enforced in SetListeningStagesHandler — so the model
// keeps its original name rather than breaking the reader-content field
// `listeningStages` that VoxOrd consumes.
//
// References Exercise by FK so grading reuses exercise-engine; ordering and
// staging are kept local to the lesson rather than in the generic
// ContentRelation graph, which has no position column and one-row-per-pair
// uniqueness that cannot express an ordered sequence.
model LessonListeningStage {
  id                     String             @id @default(uuid()) @db.Uuid
  lessonContentVariantId String             @map("lesson_content_variant_id") @db.Uuid
  exerciseId             String             @map("exercise_id") @db.Uuid
  position               Int
  stageType              ListeningStageType @map("stage_type")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz

  variant  LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)
  exercise Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([lessonContentVariantId, position])
  @@index([lessonContentVariantId])
  @@index([exerciseId])
  @@map("lesson_listening_stages")
}

// Single optional comprehension-check exercise for a VIDEO-kind lesson variant.
// References Exercise by FK so grading reuses exercise-engine, mirroring
// LessonListeningStage's link but without position/stageType since a video
// variant carries at most one comprehension question.
model LessonVideoQuestion {
  id                     String   @id @default(uuid()) @db.Uuid
  lessonContentVariantId String   @unique @map("lesson_content_variant_id") @db.Uuid
  exerciseId             String   @map("exercise_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant  LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)
  exercise Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@map("lesson_video_questions")
}

// Paragraph-aligned translation for Bilingual/Focus reading modes on a TEXT-kind
// lesson variant. Keyed to the 0-based paragraph split of body_markdown (blank-line
// delimited). Translation language is implicitly the parent variant's
// explanation_language — one variant already represents a single explanation
// language, so no separate language column is needed. Replaced atomically
// (delete+createMany) whenever the author resubmits translations, mirroring
// LessonVariantMediaRef. Missing rows degrade the reader to Immersive-only.
model LessonParagraphTranslation {
  id                     String   @id @default(uuid()) @db.Uuid
  lessonContentVariantId String   @map("lesson_content_variant_id") @db.Uuid
  paragraphIndex         Int      @map("paragraph_index")
  translation            String   @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)

  @@unique([lessonContentVariantId, paragraphIndex])
  @@index([lessonContentVariantId])
  @@map("lesson_paragraph_translations")
}

// Author-marked glossary words for a lesson variant (TEXT or VIDEO). Explicitly
// marked via the authoring glossary panel rather than parsed from markdown —
// occurrenceCount is caller-supplied per mark call, incremented on repeat marks
// of the same word. Drives the per-lesson "marked-word count" pre-flight signal.
// The module-level glossary itself stays on ContentRelation (INTRODUCES,
// CONTAINER -> VOCABULARY_ITEM, already read by get-expanded-module) — marking
// a word here also upserts that relation for every module containing this
// lesson, resolved via ContainerItem at mark time.
model LessonVariantGlossaryMark {
  id                     String   @id @default(uuid()) @db.Uuid
  lessonContentVariantId String   @map("lesson_content_variant_id") @db.Uuid
  vocabularyItemId       String   @map("vocabulary_item_id") @db.Uuid
  occurrenceCount        Int      @default(1) @map("occurrence_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant        LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)
  vocabularyItem VocabularyItem       @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([lessonContentVariantId, vocabularyItemId])
  @@index([lessonContentVariantId])
  @@index([vocabularyItemId])
  @@map("lesson_variant_glossary_marks")
}

// Positional author annotation over a TEXT lesson variant's body — the model
// behind lexis/grammar/chunk highlighting in the reader (spec 16).
//
// Offsets are UTF-16 indices into the raw markdown of paragraph `paragraph_index`
// as split by MarkdownParagraphSplitterService — the same numbering that keys
// LessonParagraphTranslation, so a variant has one paragraph numbering, not two.
// They are validated in application code only: Postgres substring() counts code
// points, JavaScript counts UTF-16 units, and the clients are all JavaScript.
//
// text_snapshot is what the author selected at creation time. Offsets rot the
// moment the body is edited, so a span whose snapshot no longer matches the body
// is "broken": computed on read (never stored — a flag would need invalidating
// on every body edit), withheld from the reader, and surfaced to the author for
// re-anchoring.
//
// ref_id is polymorphic by kind (VOCAB -> vocabulary_items.id, GRAMMAR ->
// grammar_rules.id, CHUNK -> NULL) and therefore carries no FK, mirroring
// ContentRelation. An unresolvable ref_id is also treated as broken at read
// time, so an orphan can never render.
model LessonTextSpan {
  id                     String         @id @default(uuid()) @db.Uuid
  lessonContentVariantId String         @map("lesson_content_variant_id") @db.Uuid
  paragraphIndex         Int            @map("paragraph_index")
  charStart              Int            @map("char_start")
  charEnd                Int            @map("char_end")
  kind                   LessonSpanKind
  refId                  String?        @map("ref_id") @db.Uuid
  textSnapshot           String         @map("text_snapshot") @db.VarChar(400)
  note                   String?        @db.VarChar(500)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  createdByUserId        String         @map("created_by_user_id") @db.Uuid

  // CHECK constraints (raw SQL, in the same migration):
  //   char_start >= 0 AND char_end > char_start
  //   paragraph_index >= 0
  //   (kind = 'chunk') = (ref_id IS NULL)
  variant LessonContentVariant @relation(fields: [lessonContentVariantId], references: [id], onDelete: Cascade)

  @@index([lessonContentVariantId])
  @@index([lessonContentVariantId, paragraphIndex])
  @@index([refId])
  @@map("lesson_text_spans")
}

// ─── Block 3: Vocabulary ──────────────────────────────────────────────────────

// A named collection of vocabulary items owned by a user or school.
// slug is NULL for non-public lists; generated at creation if visibility = PUBLIC,
// or at the moment visibility is changed to PUBLIC. Immutable after first assignment.
// Partial unique index on (slug) WHERE slug IS NOT NULL AND deleted_at IS NULL
// is enforced via raw SQL migration (add-vocabulary-constraints).
model VocabularyList {
  id                String          @id @default(uuid()) @db.Uuid
  slug              String?         @db.VarChar(120)
  title             String          @db.VarChar(200)
  description       String?         @db.Text
  targetLanguage    String          @map("target_language") @db.VarChar(10)
  difficultyLevel   DifficultyLevel @map("difficulty_level")
  ownerUserId       String          @map("owner_user_id") @db.Uuid
  ownerSchoolId     String?         @map("owner_school_id") @db.Uuid
  // CHECK constraints (raw SQL):
  //   owner_school_id IS NULL     → visibility IN ('public','shared','private')
  //   owner_school_id IS NOT NULL → visibility IN ('public','school_private','shared','private')
  visibility        Visibility
  autoAddToSrs      Boolean         @default(true) @map("auto_add_to_srs")
  coverImageMediaId String?         @map("cover_image_media_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz

  items VocabularyItem[]

  @@index([ownerUserId])
  @@index([ownerSchoolId])
  @@index([visibility])
  @@index([targetLanguage, difficultyLevel])
  @@index([deletedAt, visibility, targetLanguage])
  @@map("vocabulary_lists")
}

// A single word/phrase entry within a vocabulary list.
// word is case-preserved. position is 0-based.
// Unique constraints: (vocabularyListId, position) and (vocabularyListId, word).
// CHECK constraint (raw SQL): length(trim(word)) > 0
model VocabularyItem {
  id                        String        @id @default(uuid()) @db.Uuid
  vocabularyListId          String        @map("vocabulary_list_id") @db.Uuid
  word                      String        @db.VarChar(200)
  position                  Int
  partOfSpeech              PartOfSpeech? @map("part_of_speech")
  ipaTranscription          String?       @map("ipa_transcription") @db.VarChar(200)
  pronunciationAudioMediaId String?       @map("pronunciation_audio_media_id") @db.Uuid
  // JSONB; validated against a per-language schema in application code (not DB).
  grammaticalProperties     Json?         @map("grammatical_properties")
  register                  Register?
  notes                     String?       @db.Text
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?     @map("deleted_at") @db.Timestamptz

  vocabularyList VocabularyList              @relation(fields: [vocabularyListId], references: [id], onDelete: Cascade)
  translations   VocabularyItemTranslation[]
  usageExamples  VocabularyUsageExample[]
  glossaryMarks  LessonVariantGlossaryMark[]

  @@unique([vocabularyListId, position])
  @@unique([vocabularyListId, word])
  @@index([vocabularyListId])
  @@index([vocabularyListId, deletedAt])
  @@index([partOfSpeech])
  @@map("vocabulary_items")
}

// One translation row per (item, language). Upserted — never duplicated.
model VocabularyItemTranslation {
  id                      String   @id @default(uuid()) @db.Uuid
  vocabularyItemId        String   @map("vocabulary_item_id") @db.Uuid
  translationLanguage     String   @map("translation_language") @db.VarChar(10)
  primaryTranslation      String   @map("primary_translation") @db.VarChar(300)
  alternativeTranslations String[] @default([]) @map("alternative_translations")
  definition              String?  @db.Text
  usageNotes              String?  @map("usage_notes") @db.Text
  falseFriendWarning      String?  @map("false_friend_warning") @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdByUserId         String   @map("created_by_user_id") @db.Uuid
  lastEditedByUserId      String   @map("last_edited_by_user_id") @db.Uuid

  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([vocabularyItemId, translationLanguage])
  @@index([vocabularyItemId])
  @@index([translationLanguage])
  @@map("vocabulary_item_translations")
}

// Example sentence illustrating how the word is used in context.
// position is 0-based within the parent item.
model VocabularyUsageExample {
  id               String   @id @default(uuid()) @db.Uuid
  vocabularyItemId String   @map("vocabulary_item_id") @db.Uuid
  exampleText      String   @map("example_text") @db.Text
  position         Int      @default(0)
  audioMediaId     String?  @map("audio_media_id") @db.Uuid
  contextNote      String?  @map("context_note") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vocabularyItem VocabularyItem                 @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  translations   VocabularyExampleTranslation[]

  @@unique([vocabularyItemId, position])
  @@index([vocabularyItemId])
  @@map("vocabulary_usage_examples")
}

// Translation of a usage example into a student's language.
model VocabularyExampleTranslation {
  id                       String   @id @default(uuid()) @db.Uuid
  vocabularyUsageExampleId String   @map("vocabulary_usage_example_id") @db.Uuid
  translationLanguage      String   @map("translation_language") @db.VarChar(10)
  translatedText           String   @map("translated_text") @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  usageExample VocabularyUsageExample @relation(fields: [vocabularyUsageExampleId], references: [id], onDelete: Cascade)

  @@unique([vocabularyUsageExampleId, translationLanguage])
  @@index([vocabularyUsageExampleId])
  @@map("vocabulary_example_translations")
}

// ─── Block 4 Enums ─────────────────────────────────────────────────────────────

enum GrammarTopic {
  VERBS        @map("verbs")
  NOUNS        @map("nouns")
  ADJECTIVES   @map("adjectives")
  ADVERBS      @map("adverbs")
  PRONOUNS     @map("pronouns")
  ARTICLES     @map("articles")
  PREPOSITIONS @map("prepositions")
  CONJUNCTIONS @map("conjunctions")
  WORD_ORDER   @map("word_order")
  TENSES       @map("tenses")
  CASES        @map("cases")
  MOOD         @map("mood")
  VOICE        @map("voice")
  NUMERALS     @map("numerals")
  OTHER        @map("other")

  @@map("grammar_topic")
}

// ─── Block 4: Exercise Templates (read-only seed data) ────────────────────────
// Templates define the JSON schema for exercise content and answers.
// supportedLanguages: null = all languages supported; non-null = restricted list.
// No CRUD mutations at runtime — only GET list/by-code endpoints.
model ExerciseTemplate {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(50)
  name                 String   @db.VarChar(100)
  description          String?  @db.Text
  contentSchema        Json     @map("content_schema")
  answerSchema         Json     @map("answer_schema")
  defaultCheckSettings Json?    @map("default_check_settings")
  // Nullable JSON array of BCP-47 language tags. null = all languages supported.
  supportedLanguages   Json?    @map("supported_languages")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  exercises Exercise[]

  @@map("exercise_templates")
}

// ─── Block 4: Exercises ───────────────────────────────────────────────────────
// content validated against template.content_schema in application layer.
// expectedAnswers validated against template.answer_schema.
// answerCheckSettings overrides template.defaultCheckSettings at read time (shallow merge).
// CHECK constraints (raw SQL):
//   visibility vs owner_school_id (same pattern as lessons/vocabulary)
model Exercise {
  id                       String          @id @default(uuid()) @db.Uuid
  exerciseTemplateId       String          @map("exercise_template_id") @db.Uuid
  targetLanguage           String          @map("target_language") @db.VarChar(10)
  difficultyLevel          DifficultyLevel @map("difficulty_level")
  content                  Json
  expectedAnswers          Json            @map("expected_answers")
  answerCheckSettings      Json?           @map("answer_check_settings")
  // Unreleased edit. Authoring writes here and students keep reading the columns
  // above until the container placing this exercise is published, which promotes
  // the draft. `draft_updated_at` is the flag: set means the other three are the
  // complete document to release, null means there is nothing waiting.
  draftContent             Json?           @map("draft_content")
  draftExpectedAnswers     Json?           @map("draft_expected_answers")
  draftAnswerCheckSettings Json?           @map("draft_answer_check_settings")
  draftUpdatedAt           DateTime?       @map("draft_updated_at") @db.Timestamptz
  // What the author says this exercise trains, overruling what plan 55 derives from
  // the template, the placement and the document. `override_set_at` is the marker:
  // null means "trust the derivation" and the two arrays are ignored, non-null means
  // the author spoke — an empty array then means "counts towards nothing", which is a
  // statement rather than a gap. Prisma cannot express a nullable list, which is why
  // the marker is a column of its own rather than a null array.
  skillsOverride           String[]        @map("skills_override")
  focusOverride            String[]        @map("focus_override")
  overrideSetAt            DateTime?       @map("override_set_at") @db.Timestamptz
  ownerUserId              String          @map("owner_user_id") @db.Uuid
  ownerSchoolId            String?         @map("owner_school_id") @db.Uuid
  visibility               Visibility
  estimatedDurationSeconds Int?            @map("estimated_duration_seconds")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?       @map("deleted_at") @db.Timestamptz

  template        ExerciseTemplate          @relation(fields: [exerciseTemplateId], references: [id])
  instructions    ExerciseInstruction[]
  poolEntries     GrammarRuleExercisePool[]
  listeningStages LessonListeningStage[]
  videoQuestions  LessonVideoQuestion[]

  @@index([exerciseTemplateId])
  @@index([ownerUserId])
  @@index([ownerSchoolId])
  @@index([visibility])
  @@index([targetLanguage, difficultyLevel])
  @@index([deletedAt, visibility, targetLanguage])
  @@map("exercises")
}

// Per-language instruction for an exercise.
// instructionLanguage × exerciseId must be unique (@@unique below).
// text_overrides JSONB: keys are placeholder tokens ($$token$$), values are per-language strings.
// Content Service stores and returns them; frontend resolves substitution client-side.
model ExerciseInstruction {
  id                   String    @id @default(uuid()) @db.Uuid
  exerciseId           String    @map("exercise_id") @db.Uuid
  instructionLanguage  String    @map("instruction_language") @db.VarChar(10)
  instructionText      String    @map("instruction_text") @db.Text
  hintText             String?   @map("hint_text") @db.Text
  textOverrides        Json?     @map("text_overrides")
  // Unreleased edit, on the same terms as the exercise document it belongs to:
  // `draft_updated_at` set means these three are what publishing will release.
  draftInstructionText String?   @map("draft_instruction_text") @db.Text
  draftHintText        String?   @map("draft_hint_text") @db.Text
  draftTextOverrides   Json?     @map("draft_text_overrides")
  draftUpdatedAt       DateTime? @map("draft_updated_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, instructionLanguage])
  @@index([exerciseId])
  @@map("exercise_instructions")
}

// ─── Block 5 Enums ─────────────────────────────────────────────────────────────

enum TagCategory {
  TOPIC     @map("topic")
  SITUATION @map("situation")
  SKILL     @map("skill")
  LEVEL     @map("level")
  OTHER     @map("other")

  @@map("tag_category")
}

enum TagScope {
  GLOBAL @map("global")
  SCHOOL @map("school")

  @@map("tag_scope")
}

// Reused for both tag_assignments.entity_type and content_shares.entity_type.
// Single-sourced here; if split later add a comment explaining divergence.
enum TaggableEntityType {
  CONTAINER       @map("container")
  LESSON          @map("lesson")
  VOCABULARY_LIST @map("vocabulary_list")
  GRAMMAR_RULE    @map("grammar_rule")
  EXERCISE        @map("exercise")

  @@map("taggable_entity_type")
}

enum SharePermission {
  READ            @map("read")
  READ_AND_REVIEW @map("read_and_review")
  // Co-author role: grants edit access on the shared entity.
  EDIT            @map("edit")

  @@map("share_permission")
}

enum EntitlementType {
  MANUAL            @map("manual")
  SUBSCRIPTION      @map("subscription")
  ONE_TIME_PURCHASE @map("one_time_purchase")
  PROMOTIONAL       @map("promotional")
  FREE_GRANTED      @map("free_granted")

  @@map("entitlement_type")
}

// ─── Block 4: Grammar Rules ───────────────────────────────────────────────────
// Language-neutral rule with topic categorization.
// slug: NULL until first published explanation if visibility = PUBLIC; immutable after.
// Partial unique index on slug WHERE slug IS NOT NULL AND deleted_at IS NULL (raw SQL).
// CHECK constraints (raw SQL): visibility vs owner_school_id.
model GrammarRule {
  id              String          @id @default(uuid()) @db.Uuid
  slug            String?         @db.VarChar(120)
  targetLanguage  String          @map("target_language") @db.VarChar(10)
  difficultyLevel DifficultyLevel @map("difficulty_level")
  topic           GrammarTopic
  subtopic        String?         @db.VarChar(100)
  title           String          @db.VarChar(200)
  description     String?         @db.Text
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  ownerSchoolId   String?         @map("owner_school_id") @db.Uuid
  visibility      Visibility
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz

  explanations GrammarRuleExplanation[]
  exercisePool GrammarRuleExercisePool[]

  @@index([ownerUserId])
  @@index([ownerSchoolId])
  @@index([visibility])
  @@index([targetLanguage, difficultyLevel])
  @@index([topic])
  @@index([deletedAt, visibility, targetLanguage])
  @@map("grammar_rules")
}

// One explanation per (grammar_rule_id, explanation_language, min_level, max_level).
// Mirrors the LessonContentVariant pattern: same DRAFT/PUBLISHED lifecycle,
// same best-variant selection algorithm (BestVariantSelectorService).
// displaySummary: short summary shown in grammar rule lists (no bodyMarkdown).
// deletedAt: set via cascade when parent grammar rule is soft-deleted.
// CHECK constraint (raw SQL): ordinal(min_level) <= ordinal(max_level).
model GrammarRuleExplanation {
  id                      String          @id @default(uuid()) @db.Uuid
  grammarRuleId           String          @map("grammar_rule_id") @db.Uuid
  explanationLanguage     String          @map("explanation_language") @db.VarChar(10)
  minLevel                DifficultyLevel @map("min_level")
  maxLevel                DifficultyLevel @map("max_level")
  displayTitle            String          @map("display_title") @db.VarChar(200)
  displaySummary          String?         @map("display_summary") @db.Text
  bodyMarkdown            String          @map("body_markdown") @db.Text
  estimatedReadingMinutes Int?            @map("estimated_reading_minutes")
  // Reader "anchor" block: a highlighted example sentence with substrings to
  // highlight in it (anchorHighlights) and an optional explanatory note.
  anchorText              String?         @map("anchor_text") @db.Text
  anchorHighlights        String[]        @default([]) @map("anchor_highlights")
  anchorNote              String?         @map("anchor_note") @db.Text
  status                  VariantStatus   @default(DRAFT)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdByUserId         String          @map("created_by_user_id") @db.Uuid
  lastEditedByUserId      String          @map("last_edited_by_user_id") @db.Uuid
  publishedAt             DateTime?       @map("published_at") @db.Timestamptz
  deletedAt               DateTime?       @map("deleted_at") @db.Timestamptz

  grammarRule     GrammarRule                 @relation(fields: [grammarRuleId], references: [id], onDelete: Cascade)
  compareExamples GrammarRuleCompareExample[]
  quickCheck      GrammarRuleQuickCheck?

  @@unique([grammarRuleId, explanationLanguage, minLevel, maxLevel])
  @@index([grammarRuleId])
  @@index([grammarRuleId, status])
  @@map("grammar_rule_explanations")
}

// Ordered correct/incorrect sentence pairs (with optional note) shown in the
// grammar reader's "compare" list. Replaces the examples: string[] hack that
// packed fake examples into bodyMarkdown behind an <!-- examples --> marker.
// Replaced atomically (delete+createMany in a transaction) via a bulk-set command,
// same shape/precedent as LessonVideoCue.
model GrammarRuleCompareExample {
  id            String   @id @default(uuid()) @db.Uuid
  explanationId String   @map("explanation_id") @db.Uuid
  position      Int
  sentence      String   @db.Text
  note          String?  @db.Text
  isCorrect     Boolean  @map("is_correct")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  explanation GrammarRuleExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@unique([explanationId, position])
  @@index([explanationId])
  @@map("grammar_rule_compare_examples")
}

// Single optional MCQ quick-check shown at the end of the grammar reader page.
// 0..1 per explanation (explanationId is unique). Upserted-or-cleared as a whole.
model GrammarRuleQuickCheck {
  id                 String   @id @default(uuid()) @db.Uuid
  explanationId      String   @unique @map("explanation_id") @db.Uuid
  question           String   @db.Text
  options            String[]
  correctOptionIndex Int      @map("correct_option_index")
  explanation        String   @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  grammarRuleExplanation GrammarRuleExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@map("grammar_rule_quick_checks")
}

// Many-to-many join between grammar rules and exercises.
// weight (default 1.0) drives weighted random exercise selection.
// position is 0-based; gaps allowed after removal; restored to continuous by reorder.
// Soft-deleted exercises remain in pool rows but are excluded at query time.
// CHECK constraint (raw SQL): weight > 0.
model GrammarRuleExercisePool {
  id            String   @id @default(uuid()) @db.Uuid
  grammarRuleId String   @map("grammar_rule_id") @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  position      Int
  weight        Float    @default(1.0)
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz
  addedByUserId String   @map("added_by_user_id") @db.Uuid

  grammarRule GrammarRule @relation(fields: [grammarRuleId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([grammarRuleId, exerciseId])
  @@index([grammarRuleId])
  @@index([exerciseId])
  @@map("grammar_rule_exercise_pool")
}

// ─── Block 5: Tags ─────────────────────────────────────────────────────────────

// Global tags are created by platform_admin (owner_school_id IS NULL).
// School-scoped tags are created by school content_admin/owner (owner_school_id IS NOT NULL).
// Partial unique index on (slug, scope, owner_school_id) WHERE deleted_at IS NULL
// is enforced via raw SQL migration (block-5-constraints) — Prisma cannot express this.
// CHECK constraint tags_scope_owner_consistent also added via raw SQL:
//   (scope='global' AND owner_school_id IS NULL) OR (scope='school' AND owner_school_id IS NOT NULL)
model Tag {
  id              String      @id @default(uuid()) @db.Uuid
  slug            String      @db.VarChar(80)
  name            String      @db.VarChar(100)
  category        TagCategory
  scope           TagScope
  ownerSchoolId   String?     @map("owner_school_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz
  createdByUserId String      @map("created_by_user_id") @db.Uuid

  assignments TagAssignment[]

  @@index([scope, deletedAt])
  @@index([ownerSchoolId])
  @@map("tags")
}

// Polymorphic assignments of tags to any taggable entity.
// entityId is a raw UUID — no Prisma relation (polymorphic FK not supported by Prisma).
// Uniqueness enforced by @@unique([tagId, entityType, entityId]).
model TagAssignment {
  id               String             @id @default(uuid()) @db.Uuid
  tagId            String             @map("tag_id") @db.Uuid
  entityType       TaggableEntityType @map("entity_type")
  // Polymorphic reference — validated in application layer; no Prisma FK.
  entityId         String             @map("entity_id") @db.Uuid
  assignedAt       DateTime           @default(now()) @map("assigned_at") @db.Timestamptz
  assignedByUserId String             @map("assigned_by_user_id") @db.Uuid

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([tagId])
  @@map("tag_assignments")
}

// ─── Block 5: Content Shares ──────────────────────────────────────────────────

// Grants per-user read access to entities with visibility='shared'.
// Partial unique index on (entity_type, entity_id, shared_with_user_id) WHERE revoked_at IS NULL
// is enforced via raw SQL migration (block-5-constraints).
// CHECK constraint content_shares_expires_after_created added via raw SQL:
//   expires_at IS NULL OR expires_at > created_at
model ContentShare {
  id               String             @id @default(uuid()) @db.Uuid
  entityType       TaggableEntityType @map("entity_type")
  // Polymorphic reference — no Prisma FK.
  entityId         String             @map("entity_id") @db.Uuid
  sharedWithUserId String             @map("shared_with_user_id") @db.Uuid
  sharedByUserId   String             @map("shared_by_user_id") @db.Uuid
  permission       SharePermission    @default(READ)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz
  note             String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([sharedWithUserId, revokedAt])
  @@index([entityType, entityId])
  @@index([expiresAt])
  @@map("content_shares")
}

// ─── Block 5: Content Entitlements ────────────────────────────────────────────

// Paid or granted access to containers with specific access_tier requirements.
// containerId is stored as a raw UUID — raw FK (ON DELETE RESTRICT) added via raw SQL
// migration (block-5-constraints) named content_entitlements_container_fk.
// Partial unique index on (user_id, container_id) WHERE revoked_at IS NULL enforced via raw SQL.
// CHECK constraint content_entitlements_expires_after_granted added via raw SQL:
//   expires_at IS NULL OR expires_at > granted_at
model ContentEntitlement {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  // Polymorphic-style FK to containers.id — no Prisma relation; raw FK added via migration.
  containerId     String          @map("container_id") @db.Uuid
  entitlementType EntitlementType @map("entitlement_type")
  grantedAt       DateTime        @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz
  grantedByUserId String?         @map("granted_by_user_id") @db.Uuid
  sourceReference String?         @map("source_reference") @db.VarChar(200)
  metadata        Json?

  @@index([userId, containerId])
  @@index([userId, expiresAt])
  @@index([containerId])
  @@map("content_entitlements")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────
// Transactional outbox: events written atomically with the domain change.
// OutboxRelayService polls and publishes to RabbitMQ. See ADR-011.

model Outbox {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String    @db.Text
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

// ─── Idempotency ──────────────────────────────────────────────────────────────
// processorId scopes idempotency per consumer.

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  processorId String   @map("processor_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([eventId, processorId])
  @@index([processorId])
  @@map("processed_events")
}

// ─── Content Relations — the atom graph (Plan 21 §1) ──────────────────────────
// Polymorphic, directed edges between content atoms. Powers word-in-context,
// exercise→atom crediting (PRACTICED_BY), and ordering (PREREQUISITE).
// Attached to language-neutral entities (not versions/variants) so relations
// survive re-publishing. Superset of TaggableEntityType: also covers the
// VOCABULARY_ITEM and CAN_DO_DESCRIPTOR granularity the relation graph needs.
enum RelatableEntityType {
  CONTAINER         @map("container")
  LESSON            @map("lesson")
  VOCABULARY_LIST   @map("vocabulary_list")
  VOCABULARY_ITEM   @map("vocabulary_item")
  GRAMMAR_RULE      @map("grammar_rule")
  EXERCISE          @map("exercise")
  CAN_DO_DESCRIPTOR @map("can_do_descriptor")

  @@map("relatable_entity_type")
}

enum RelationKind {
  INTRODUCES   @map("introduces")
  FEATURES     @map("features")
  PRACTICED_BY @map("practiced_by")
  PREREQUISITE @map("prerequisite")
  RELATED      @map("related")
  TARGETS      @map("targets")

  @@map("relation_kind")
}

// sourceId/targetId are raw UUIDs — polymorphic, validated in the application
// layer (same trade-off already accepted for TagAssignment.entityId).
// Dangling relations (target soft-deleted) are filtered at read time, like
// GrammarRuleExercisePool; explicit unlink hard-deletes the row.
model ContentRelation {
  id              String              @id @default(uuid()) @db.Uuid
  sourceType      RelatableEntityType @map("source_type")
  sourceId        String              @map("source_id") @db.Uuid
  targetType      RelatableEntityType @map("target_type")
  targetId        String              @map("target_id") @db.Uuid
  relationKind    RelationKind        @map("relation_kind")
  ownerSchoolId   String?             @map("owner_school_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String              @map("created_by_user_id") @db.Uuid

  @@unique([sourceType, sourceId, relationKind, targetType, targetId])
  @@index([sourceType, sourceId, relationKind])
  @@index([targetType, targetId, relationKind])
  @@map("content_relations")
}

// ─── Can-do descriptors (Plan 23 B1) ─────────────────────────────────────────
// CEFR-aligned "I can…" statements. GLOBAL descriptors form the platform library;
// SCHOOL descriptors extend it per school. Scope CHECK mirrors the Tag pattern.
// Localizations carry the text in each supported UI language (defaulting to `en`
// if a locale is missing). A MODULE → TARGETS → CanDoDescriptor ContentRelation
// links a module to the competences it develops.

enum CanDoSkill {
  LISTENING @map("listening")
  READING   @map("reading")
  SPOKEN    @map("spoken")
  WRITTEN   @map("written")

  @@map("can_do_skill")
}

enum CanDoScope {
  GLOBAL @map("global")
  SCHOOL @map("school")

  @@map("can_do_scope")
}

// CHECK: (scope='global' AND owner_school_id IS NULL) OR (scope='school' AND owner_school_id IS NOT NULL)
model CanDoDescriptor {
  id              String          @id @default(uuid()) @db.Uuid
  cefrLevel       DifficultyLevel @map("cefr_level")
  skill           CanDoSkill
  scope           CanDoScope
  ownerSchoolId   String?         @map("owner_school_id") @db.Uuid
  source          String?         @db.VarChar(80)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz
  createdByUserId String          @map("created_by_user_id") @db.Uuid

  localizations CanDoDescriptorLocalization[]

  @@index([cefrLevel, skill, scope])
  @@index([ownerSchoolId])
  @@map("can_do_descriptors")
}

// One row per (descriptor, language). `text` is the "I can…" statement.
model CanDoDescriptorLocalization {
  id           String @id @default(uuid()) @db.Uuid
  descriptorId String @map("descriptor_id") @db.Uuid
  language     String @db.VarChar(10)
  text         String @db.Text

  descriptor CanDoDescriptor @relation(fields: [descriptorId], references: [id], onDelete: Cascade)

  @@unique([descriptorId, language])
  @@map("can_do_descriptor_localizations")
}

// ─── Audit log ────────────────────────────────────────────────────────────────
// Who changed what, and when. Written by the command handlers, which are the only
// layer that knows both the change and the actor behind it — domain events carry
// neither. Read per container: an entry is not tied to one, because an exercise
// can be placed by several and its edit belongs to every feed that shows it.

enum AuditEntityType {
  CONTAINER       @map("container")
  LESSON          @map("lesson")
  EXERCISE        @map("exercise")
  VOCABULARY_LIST @map("vocabulary_list")
  GRAMMAR_RULE    @map("grammar_rule")

  @@map("audit_entity_type")
}

model ContentAuditLog {
  id            String          @id @default(uuid()) @db.Uuid
  entityType    AuditEntityType @map("entity_type")
  entityId      String          @map("entity_id") @db.Uuid
  // Free text rather than an enum on purpose: actions are added far more often
  // than entity types, and each new one would otherwise cost a migration.
  action        String          @db.VarChar(40)
  actorUserId   String          @map("actor_user_id") @db.Uuid
  // Which fields the change touched, for entries that report an edit.
  changedFields String[]        @map("changed_fields")
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("content_audit_log")
}
