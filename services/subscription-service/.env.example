# ─── Application ──────────────────────────────────────────────────────────────
PORT=3011
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://subscription_service:localdevpassword@localhost:5432/subscriptions_db?schema=public"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://auth.ssz-platform.internal"
JWT_AUDIENCE="ssz-services"

# ─── Service-to-service ───────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=change-me-in-prod

# ─── Other services ───────────────────────────────────────────────────────────
ORGANIZATION_SERVICE_URL=http://localhost:3002
