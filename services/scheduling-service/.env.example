# ─── Application ──────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://content_service:content_service_password@localhost:5432/content_db?schema=public"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://auth.ssz-platform.internal"
JWT_AUDIENCE="ssz-services"

# ─── Organization Service (VisibilityGuard role checks) ───────────────────────
ORGANIZATION_SERVICE_URL=http://localhost:3002
ORGANIZATION_SERVICE_TIMEOUT_MS=2000
ORGANIZATION_SERVICE_RETRIES=2
INTERNAL_SERVICE_TOKEN=change-me-in-prod

# ─── Discovery / Catalog Pagination ───────────────────────────────────────────
DISCOVERY_DEFAULT_LIMIT=20
DISCOVERY_MAX_LIMIT=100
