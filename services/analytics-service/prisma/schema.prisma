generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Event Archive ────────────────────────────────────────────────────────────
// Append-only store of every domain event received from all RabbitMQ exchanges.
// sequence is the monotonic replay cursor. eventId deduplicates at-least-once delivery.
// The archive is the single source of truth for replay; projections read from it.

model EventArchive {
  id         String   @id @default(uuid())
  sequence   BigInt   @default(autoincrement()) @unique
  eventId    String   @unique @map("event_id")
  eventType  String   @map("event_type")
  exchange   String
  routingKey String   @map("routing_key")
  source     String
  payload    Json
  occurredAt DateTime @map("occurred_at")
  archivedAt DateTime @default(now()) @map("archived_at")

  @@index([eventType, occurredAt])
  @@index([occurredAt])
  @@map("event_archive")
}

// ─── Idempotency ──────────────────────────────────────────────────────────────
// processorId scopes idempotency per consumer so multiple projection consumers
// can each track their own processed set for the same eventId.

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  processorId String   @map("processor_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([eventId, processorId])
  @@index([processorId])
  @@map("processed_events")
}

// ─── Projection: SchoolMembership ─────────────────────────────────────────────
// Built from school.member.added / school.member.removed / school.created events.
// Used for analytics authorization and attribution (ownerId → schoolId).

model SchoolMembership {
  id       String   @id @default(uuid())
  schoolId String   @map("school_id")
  userId   String   @map("user_id")
  role     String
  joinedAt DateTime @map("joined_at")

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_membership")
}

// ─── Projection: UserDirectory ────────────────────────────────────────────────
// Built from profile.created / profile.updated events.
// Used to denormalize actorName and at-risk student names.

model UserDirectory {
  userId      String   @id @map("user_id")
  displayName String   @map("display_name")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_directory")
}

// ─── Projection: ContainerDirectory ──────────────────────────────────────────
// Built from content.container.* events.
// Provides title/lang/leafItemCount for course-health and at-risk widgets.
// leafItemCount starts at 0 and will be incremented once container-item events exist.

model ContainerDirectory {
  containerId   String    @id @map("container_id")
  title         String
  lang          String
  ownerUserId   String    @map("owner_user_id")
  ownerSchoolId String?   @map("owner_school_id")
  containerType String    @map("container_type")
  leafItemCount Int       @default(0) @map("leaf_item_count")
  deletedAt     DateTime? @map("deleted_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([ownerSchoolId])
  @@map("container_directory")
}

// ─── Projection: GroupDirectory ──────────────────────────────────────────────
// Built from school.group.published / school.group.archived events.
// Provides group metadata for student list responses.

model GroupDirectory {
  groupId   String    @id @map("group_id")
  schoolId  String    @map("school_id")
  name      String
  lang      String?
  level     String?
  courseId  String?   @map("course_id")
  status    String    // active | archived | draft
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("group_directory")
}

// ─── Projection: GroupMembership ─────────────────────────────────────────────
// Built from school.group.member.added / school.group.member.removed events.
// Used for unassigned-status derivation and student→group attribution.

model GroupMembership {
  id       String @id @default(uuid())
  groupId  String @map("group_id")
  schoolId String @map("school_id")
  userId   String @map("user_id")

  @@unique([groupId, userId])
  @@index([schoolId, userId])
  @@index([groupId])
  @@map("group_membership")
}

// ─── Projection: EnrollmentProjection ────────────────────────────────────────
// Built from learning.enrollment.* events + seed.
// Canonical set of active enrollments — basis for schoolStudents(S) and course-health.

model EnrollmentProjection {
  enrollmentId String    @id @map("enrollment_id")
  userId       String    @map("user_id")
  containerId  String    @map("container_id")
  schoolId     String?   @map("school_id")
  status       String    // ACTIVE | COMPLETED | UNENROLLED
  enrolledAt   DateTime  @map("enrolled_at")
  completedAt  DateTime? @map("completed_at")
  unenrolledAt DateTime? @map("unenrolled_at")

  @@index([userId])
  @@index([schoolId])
  @@index([containerId])
  @@index([schoolId, status])
  @@map("enrollment_projection")
}

// ─── Projection: ProgressActivity ─────────────────────────────────────────────
// Append-only log of learning activity events + seed.
// Used for active_students_7d counts, sparklines, and lastActivity (at-risk).
// schoolId is intentionally null — dashboard scopes via SchoolMembership.userId join.

model ProgressActivity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  contentType String   @map("content_type")
  contentId   String   @map("content_id")
  kind        String   // updated | completed
  occurredAt  DateTime @map("occurred_at")

  @@index([userId])
  @@index([userId, kind, occurredAt])
  @@index([occurredAt])
  @@map("progress_activity")
}

// ─── Audit: SchoolActivity ────────────────────────────────────────────────────
// Human-readable activity feed for the school dashboard.
// actorName is denormalized from UserDirectory at write time.
// Separate from metric projections — qualitative context, not counts.

model SchoolActivity {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  eventType  String   @map("event_type")
  tag        String   // people | content | review | milestone
  what       String
  target     String?
  targetId   String?  @map("target_id")
  occurredAt DateTime @map("occurred_at")

  @@index([schoolId, occurredAt(sort: Desc)])
  @@map("school_activity")
}

// ─── Projection: AttemptEvidence ──────────────────────────────────────────────
// Built from learning.attempt.rated (plan 36 §A.1). One row per attempt that
// actually moved an SRS card.
//
// This is a measurement table, not a dashboard one: it exists so the ceilings the
// evidence scale puts on ratings can be calibrated against what learners really do,
// and so "the scale works" can be told apart from "the scale broke the schedule".
// That only works if the rows predate the ceilings, which is why ratingApplied is
// recorded from the start, before anything clamps it.
//
// Deliberately absent: the learner's submitted answer. Right or wrong is enough to
// calibrate, and keeping the text would accumulate personal data for no purpose.

model AttemptEvidence {
  id           String   @id @default(uuid())
  eventId      String   @unique @map("event_id")
  userId       String   @map("user_id")
  exerciseId   String   @map("exercise_id")
  templateCode String?  @map("template_code")

  // Answer form, flattened from the event so it can be grouped on without JSON
  // extraction — the whole point of the table is grouping by form.
  answerMode    String? @map("answer_mode")    // bank | free
  bankSize      Int?    @map("bank_size")      // null in free mode: there is no bank
  wordsConsumed Boolean? @map("words_consumed")

  score  Int
  passed Boolean?

  attemptOrdinal      Int    @map("attempt_ordinal")
  daysSinceLastReview Float? @map("days_since_last_review")

  // Position within a consumed bank, for the decay in §B.3. Both stay null until
  // cards are per-gap (§C.1) — before that one card stands for the whole exercise.
  gapPosition Int? @map("gap_position")
  gapCount    Int? @map("gap_count")

  ratingApplied String   @map("rating_applied") // AGAIN | HARD | GOOD | EASY
  // When the work was done: the attempt's `attemptedAt`, which for one worked on a phone
  // offline is days before the event arrived (VoxOrd offline plan, B4); the envelope's
  // time for events published before that field existed.
  occurredAt    DateTime @map("occurred_at")

  // What the attempt exercised (plan 55 §3.6), flattened for the same reason the answer
  // form above is: the profile groups on these. Empty means the publisher said nothing —
  // every event from before the axes existed — and such a row belongs to no cell at all.
  skills String[] @default([])
  focus  String[] @default([])

  // FSRS stability after the review, in days. The one number that separates a learner who
  // forgets quickly from one who never knew: both produce a run of poor ratings, and only
  // the interval the schedule settled on says which.
  stabilityAfter Float? @map("stability_after")

  // Where the work was done and for whom (plan 57 §7), flattened for the same reason
  // as the fields above: the questions worth asking of this table — does this group do
  // worse at home than in the room, how does a course's classwork compare to its
  // homework — are group-bys, and a JSON payload cannot be grouped by.
  //
  // `workContext` is null for every event published before the field existed. That is
  // not `self_study`: nobody said, and a row that cannot say belongs in no bucket.
  workContext String? @map("work_context")
  groupId     String? @map("group_id")
  containerId String? @map("container_id")
  lessonId    String? @map("lesson_id")

  // How the learner had to produce the answer (plan 63 §2 E), flattened like the rest.
  // The axis that separates two learners every other number here calls equal: 90 % on
  // recognition and 30 % on recall is not uneven knowledge, it is knowledge that has
  // reached recognition. Null for everything published before the axis existed.
  modality String? @map("modality")

  // The delivery handed part of the answer over, so a success proves one step less (plan
  // 66, Q2-B) — today a `sort_into_buckets` board with its counter on or skewed. Weighed by
  // the same kernel rule that clamped the rating. Null for every row before it: «not said»,
  // read as «not lowered».
  evidenceLowered Boolean? @map("evidence_lowered")

  // `ai` when the verdict rated here was a model's, on the work of a learner nobody reviews
  // (plan 79 §2.1). Weighed by the kernel's `reviewedBy` rule, as the rating was clamped by
  // it. Null for a teacher's verdict, the machine check, and every row before it.
  reviewedBy      String?  @map("reviewed_by")

  // Worked on a phone with no network and replayed later (VoxOrd offline plan, B4). Kept
  // to measure how much practice happens offline. False for every row before it: offline
  // attempts did not reach the server dated until the field existed.
  recordedOffline Boolean @default(false) @map("recorded_offline")

  @@index([templateCode, answerMode, occurredAt])
  @@index([userId, occurredAt])
  @@index([groupId, workContext, occurredAt])
  @@map("attempt_evidence")
}

// ─── Projection: AtomEvidence ─────────────────────────────────────────────────
// One row per (rating × atom it was evidence about) — plan 63 phase 3.
//
// A separate table rather than columns on `attempt_evidence`, and the reason is not
// tidiness. That table is defined as one row per attempt that moved a card, and five
// readers count its rows as attempts (group progress, the heatmap, group units, work
// context, the course result). An attempt with six gaps and eight addresses would
// silently multiply every one of those numbers by eight.
//
// So the coarse record keeps its meaning and the fine one gets its own table. The join
// key between them is `eventId`: both are written from the same rating, inside the same
// idempotency guard.
//
// What this table is for: "which atoms does this learner know only on recognition",
// "what has never been produced", "what is due and weak" — questions about a fact, which
// is a thing an exercise-shaped row cannot answer.

model AtomEvidence {
  id      String @id @default(uuid())
  eventId String @map("event_id")

  userId     String @map("user_id")
  exerciseId String @map("exercise_id")

  // `vocabulary_item` | `grammar_rule_atom`. A string, as everywhere this address
  // travels: a new kind of atom must not require a migration to be recorded.
  atomType String @map("atom_type")
  atomId   String @map("atom_id")

  // What the atom was doing in the item: `focus` examined it, `context` merely required
  // it. Null where nobody said — an atom that arrived through the practised-atom graph
  // rather than through an author's address, which is most of them today.
  role String? @map("role")

  // The piece of the exercise this came from, spelled as the template spells it. Null for
  // a rating of the exercise as a whole, or of a word through the fan-out.
  itemKey String? @map("item_key")

  // Which kind of card took the rating — EXERCISE | EXERCISE_GAP | VOCABULARY_WORD, and
  // GRAMMAR_ATOM from phase 5. The same rating can be evidence about an atom whether the
  // card was the gap's or the atom's own, and the two are not the same measurement.
  contentType String? @map("content_type")

  modality      String? @map("modality")
  ratingApplied String  @map("rating_applied")
  score         Int
  passed        Boolean?
  // FSRS stability after this review, in days — "forgets quickly" against "never knew".
  stabilityAfter Float? @map("stability_after")

  // Scope, carried so a report can ask about one course or one group without joining
  // back: the same questions the coarse table answers about attempts are asked here
  // about facts.
  containerId String? @map("container_id")
  groupId     String? @map("group_id")
  workContext String? @map("work_context")

  occurredAt DateTime @map("occurred_at")

  // One rating is one observation about one atom. The pair is what makes a redelivery
  // idempotent, since a single event legitimately writes several rows here.
  @@unique([eventId, atomType, atomId])
  @@index([userId, atomType, atomId, occurredAt])
  @@index([atomType, atomId, occurredAt])
  @@index([userId, modality, occurredAt])
  @@map("atom_evidence")
}

// ─── Projection: SkillMastery ─────────────────────────────────────────────────
// The learner's profile, one row per (learner × course × skill × focus) — plan 55 §4.
//
// Built from the same `learning.attempt.rated` stream as `attempt_evidence` beside it,
// and in the same consumer. That table is the raw record and never changes; this one is
// the running answer, and it is a projection precisely so that recomputing it from the
// records stays possible when the weights or the window change.
//
// `courseId` is nullable because practice outside a course is evidence too — it just is
// not evidence about that course. A learner therefore has both: rows for each course, and
// a row with no course for everything done outside one.

model SkillMastery {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  courseId String? @map("course_id")

  // `unknown` is a value here, not a missing one: it is where an attempt lands whose axis
  // nothing could derive, and today that is most of them (no ContentRelation rows are
  // seeded). Printing that bucket is the point — "no data about grammar" is an answer.
  skill String
  focus String

  // Exponentially weighted, not a lifetime mean: weakness has to be able to expire
  // (§3.9 rule 1). Each attempt moves it by the strength of the evidence it carried.
  successRateEwma Float  @map("success_rate_ewma")
  // Does it stay in memory — the number that tells "forgets quickly" from "never knew".
  meanStability   Float? @map("mean_stability")
  // NOT a median: a true one would mean keeping the sample. This is an EWMA of seconds
  // per item, named for the question it answers rather than for its arithmetic (§5 item 1).
  medianSecondsPerItem Float? @map("median_seconds_per_item")

  attempts Int @default(0)
  // The same attempts counted by what they proved. Separate from `attempts` because the
  // confidence threshold reads this one: twenty picks out of four are not twenty answers.
  weightedSample Float @default(0) @map("weighted_sample")

  lastAttemptAt DateTime @map("last_attempt_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // The migration creates this index with NULLS NOT DISTINCT, which the schema language
  // cannot express: without it Postgres treats every no-course row as distinct and the
  // profile outside a course becomes an append-only log. Read the migration, not this line.
  @@unique([userId, courseId, skill, focus])
  @@index([userId, updatedAt])
  @@map("skill_mastery")
}

// ─── Projection: SrsLimitRefusal ──────────────────────────────────────────────
// Built from learning.srs.limit_refused (plan 37 §A.1). One row per time a daily
// SRS cap turned something down.
//
// The counterpart to attempt_evidence, and the reason it is a separate table: that
// one holds attempts that reached FSRS, so a refusal is by construction absent from
// it. Whether the caps of 20 and 200 are the right numbers is a question about the
// rows that are not there, and this table is where they go.
//
// Deliberately narrow: which cap, whose day, which kind of card. What the material
// was does not change the answer to a question about volume.

model SrsLimitRefusal {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  userId      String   @map("user_id")
  kind        String // new | review
  contentType String   @map("content_type") // EXERCISE | EXERCISE_GAP | VOCABULARY_WORD
  // Which of the two daily budgets refused — lexis | grammar (plan 63 phase 6). Null on
  // every refusal recorded before the budgets were split; all of those were the one
  // budget that is now the lexical one.
  track       String?
  occurredAt  DateTime @map("occurred_at")

  @@index([kind, occurredAt])
  @@index([track, occurredAt])
  @@index([userId, occurredAt])
  @@map("srs_limit_refusals")
}

// ─── Projection: CourseOutlineItem ────────────────────────────────────────────
// The published course as a flat map of item → unit — plan 58, phase 1.
//
// Without it "absorbed" cannot be asked at all: analytics knows which items a learner
// finished, and the group's chart asks about *units*. Nothing in this service joined the
// two, and the join cannot be done per request — a group's progress touches every item of
// a course on every read.
//
// Pulled from content-service's `internal/containers/:id/outline` rather than projected
// from events: the outline is a fact about the published version, it changes only when a
// course is published, and rebuilding it from a stream of item-level events would mean
// re-deriving the version's shape here. Refreshed on `content.container.published`.
//
// Describes the published version only. A group is taught what students can see.

model CourseOutlineItem {
  id          String  @id @default(uuid())
  containerId String  @map("container_id")
  /// Which published version this row describes. Rows of an older version are deleted on
  /// refresh, not kept: two versions in the table would double every unit's item count.
  versionId   String  @map("version_id")
  /// The unit's stable identity — the module container, or the course itself for a flat
  /// course that holds its lessons directly (content-service decides this, not us).
  unitId      String  @map("unit_id")
  unitOrder   Int     @map("unit_order")
  unitTitle   String? @map("unit_title")
  itemId      String  @map("item_id")
  itemType    String  @map("item_type") // LESSON | EXERCISE | VOCABULARY_LIST | GRAMMAR_RULE
  position    Int

  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@unique([containerId, itemId])
  @@index([containerId, unitOrder])
  @@index([itemId])
  @@map("course_outline_item")
}

// ─── Projection: ItemProgress ─────────────────────────────────────────────────
// Whether a learner is done with one item of a course — plan 58, phase 1.
//
// `progress_activity` beside it is an append-only log: it answers "when did this person
// last do anything", and it cannot answer "how much of unit 4 have they passed" without
// replaying itself. This table is the current state, one row per (learner × item), and it
// is what `absorbed` is counted from.
//
// Not counted from `attempt_evidence`: that table holds attempts that reached FSRS, and a
// course is not made of those alone — a lesson read or a word list worked through is part
// of the unit the chart is about. The denominator is the unit's items, so the numerator
// has to be able to speak about every one of them.
//
// `NEEDS_REVIEW` is deliberately not "passed": the work is with a teacher, and a learner
// who is waiting for an answer has not yet taken anything away from it.

model ItemProgress {
  userId      String   @map("user_id")
  contentType String   @map("content_type") // LESSON | EXERCISE | VOCABULARY_LIST | GRAMMAR_RULE
  contentId   String   @map("content_id")
  status      String // NOT_STARTED | IN_PROGRESS | COMPLETED | NEEDS_REVIEW
  updatedAt   DateTime @map("updated_at")

  @@id([userId, contentType, contentId])
  @@index([contentId])
  @@index([userId, status])
  @@map("item_progress")
}

// ─── Rollup: AiUsageDaily ─────────────────────────────────────────────────────
// Every ai-service gateway call, folded into one row per day × agent × model × payer ×
// outcome — plan 77, step 10. Fed by `ai.call.completed`; the ledger in `ai_db` stays the
// source of truth, this is what the admin reads without touching it.
//
// Latency is kept as a histogram over fixed buckets (`ai-usage/domain/latency-histogram.ts`)
// rather than as stored percentiles: percentiles of two rows cannot be combined, bucket
// counts can, so p50/p95 come out right for any grouping a reader asks for. Changing the
// bucket bounds means rebuilding the table from the event archive.
//
// `provider_code` / `provider_model_id` are null for calls no model answered (refusals,
// a disabled agent). The unique index is NULLS NOT DISTINCT in the migration — Prisma has
// no syntax for it — so those calls still fold into one row instead of one per call.

model AiUsageDaily {
  id               String   @id @default(uuid())
  day              DateTime @db.Date
  capability       String
  providerCode     String?  @map("provider_code")
  providerModelId  String?  @map("provider_model_id")
  payerType        String   @map("payer_type") // workspace | user | platform
  payerId          String   @map("payer_id")
  outcome          String
  calls            Int
  fallbackCalls    Int      @map("fallback_calls")
  /// Calls whose credits arrived null — the model had no price in effect. Counted apart so
  /// that "cost nothing" and "cost unknown" do not add up to the same total.
  unpricedCalls    Int      @map("unpriced_calls")
  inputTokens      BigInt   @map("input_tokens")
  outputTokens     BigInt   @map("output_tokens")
  cacheReadTokens  BigInt   @map("cache_read_tokens")
  cacheWriteTokens BigInt   @map("cache_write_tokens")
  credits          Decimal  @db.Decimal(18, 6)
  latencySumMs     BigInt   @map("latency_sum_ms")
  latencyMinMs     Int      @map("latency_min_ms")
  latencyMaxMs     Int      @map("latency_max_ms")
  latencyBuckets   Int[]    @map("latency_buckets")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([day, capability, providerCode, providerModelId, payerType, payerId, outcome], map: "ai_usage_daily_dims_key")
  @@index([day])
  @@index([payerType, payerId, day])
  @@map("ai_usage_daily")
}

// ─── Rollup: AiDraftQualityDaily ──────────────────────────────────────────────
// What teachers did with the remarks of models' review drafts, per day × agent × model ×
// prompt version — plan 79, step 1.5; suggested rubric marks beside the teacher's — 1.7d. Fed by `exercise.attempt.reviewed` (`aiDraft`); the
// remarks themselves and the per-remark labels stay in exercise-engine
// (`attempt_ai_drafts`), this is the quality readout a model is chosen by.
//
// `model_id` / `prompt_version` are ai-service registry ids, nullable as the draft carries
// them; the unique index is NULLS NOT DISTINCT in the migration, as for ai_usage_daily.

model AiDraftQualityDaily {
  id               String   @id @default(uuid())
  day              DateTime @db.Date
  capability       String
  modelId          String?  @map("model_id")
  promptVersion    String?  @map("prompt_version")
  /// `review_draft`: verdicts given with a draft on screen. `review_direct` / `voice_review`
  /// (plan 82): verdicts a model delivered — a teacher's verdict after one is
  /// `teacher_verdicts`, not a review (step 6c).
  reviews          Int
  remarksAccepted  Int      @map("remarks_accepted")
  remarksEdited    Int      @map("remarks_edited")
  remarksDiscarded Int      @map("remarks_discarded")
  remarksUntouched Int      @map("remarks_untouched")
  /// Verdicts on drafts that suggested rubric marks (step 1.7d) — and the marks' counts.
  reviewsWithMarks Int      @default(0) @map("reviews_with_marks")
  marksSame        Int      @default(0) @map("marks_same")
  marksDifferent   Int      @default(0) @map("marks_different")
  /// Marks with a teacher's number beside them; the delta sums are over these (teacher − model).
  marksCompared    Int      @default(0) @map("marks_compared")
  marksDeltaSum    Int      @default(0) @map("marks_delta_sum")
  marksAbsDeltaSum Int      @default(0) @map("marks_abs_delta_sum")
  /// `review_direct` / `voice_review` rows (step 2.3b): `reviews` counts the verdicts a model delivered to a
  /// learner nobody reviews, `disputes` how many of them the learner said were wrong —
  /// folded on the review's day, so the two stay a rate. Always 0 on `review_draft` rows.
  disputes         Int      @default(0)
  /// `review_direct` / `voice_review` rows (plan 80, step 6c): teachers' verdicts on school work the model had
  /// answered first — provisional or counted at the term — on the teacher's day, and how many
  /// went the other way (approved ↔ returned). Always 0 on `review_draft` rows.
  teacherVerdicts  Int      @default(0) @map("teacher_verdicts")
  teacherOverturned Int     @default(0) @map("teacher_overturned")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([day, capability, modelId, promptVersion], map: "ai_draft_quality_daily_dims_key")
  @@index([day])
  @@map("ai_draft_quality_daily")
}

// ─── Journal: ReviewTermAcceptance ────────────────────────────────────────────
// School work a model's verdict closed at the school's term because no teacher answered,
// one row per attempt — plan 80, step 6a (R4). Fed by `exercise.attempt.ai_reviewed`
// (`acceptedAtTerm`) and by a teacher's later verdict on the same work,
// `exercise.attempt.reviewed` (`revisesVerdict`).
//
// No teacher is stored: who was answerable is the group's teachers on the day of the term,
// which organization-service keeps with dates and is asked at read time (6b). Either event
// may land first, so every column but the school is nullable and the reader takes only rows
// with `accepted_at` — a revision with nothing to revise (work closed before 6a) stays inert.

model ReviewTermAcceptance {
  attemptId      String    @id @map("attempt_id")
  schoolId       String    @map("school_id")
  groupId        String?   @map("group_id")
  containerId    String?   @map("container_id")
  userId         String?   @map("user_id")
  exerciseId     String?   @map("exercise_id")
  templateCode   String?   @map("template_code")
  /// The model's review that counted — the axes its quality is read on.
  capability     String?
  modelId        String?   @map("model_id")
  promptVersion  String?   @map("prompt_version")
  aiOutcome      String?   @map("ai_outcome") // approved | returned
  acceptedAt     DateTime? @map("accepted_at")
  /// The teacher who gave their own verdict after the term, once (plan 80, 4b).
  revisedBy      String?   @map("revised_by")
  revisedAt      DateTime? @map("revised_at")
  revisedOutcome String?   @map("revised_outcome") // approved | returned
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, acceptedAt])
  @@index([revisedBy, revisedAt])
  @@map("review_term_acceptances")
}
