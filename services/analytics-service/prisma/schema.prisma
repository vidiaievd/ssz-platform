generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Event Archive ────────────────────────────────────────────────────────────
// Append-only store of every domain event received from all RabbitMQ exchanges.
// sequence is the monotonic replay cursor. eventId deduplicates at-least-once delivery.
// The archive is the single source of truth for replay; projections read from it.

model EventArchive {
  id         String   @id @default(uuid())
  sequence   BigInt   @default(autoincrement()) @unique
  eventId    String   @unique @map("event_id")
  eventType  String   @map("event_type")
  exchange   String
  routingKey String   @map("routing_key")
  source     String
  payload    Json
  occurredAt DateTime @map("occurred_at")
  archivedAt DateTime @default(now()) @map("archived_at")

  @@index([eventType, occurredAt])
  @@index([occurredAt])
  @@map("event_archive")
}

// ─── Idempotency ──────────────────────────────────────────────────────────────
// processorId scopes idempotency per consumer so multiple projection consumers
// can each track their own processed set for the same eventId.

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  processorId String   @map("processor_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([eventId, processorId])
  @@index([processorId])
  @@map("processed_events")
}

// ─── Projection: SchoolMembership ─────────────────────────────────────────────
// Built from school.member.added / school.member.removed / school.created events.
// Used for analytics authorization and attribution (ownerId → schoolId).

model SchoolMembership {
  id       String   @id @default(uuid())
  schoolId String   @map("school_id")
  userId   String   @map("user_id")
  role     String
  joinedAt DateTime @map("joined_at")

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_membership")
}

// ─── Projection: UserDirectory ────────────────────────────────────────────────
// Built from profile.created / profile.updated events.
// Used to denormalize actorName and at-risk student names.

model UserDirectory {
  userId      String   @id @map("user_id")
  displayName String   @map("display_name")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_directory")
}

// ─── Projection: ContainerDirectory ──────────────────────────────────────────
// Built from content.container.* events.
// Provides title/lang/leafItemCount for course-health and at-risk widgets.
// leafItemCount starts at 0 and will be incremented once container-item events exist.

model ContainerDirectory {
  containerId   String    @id @map("container_id")
  title         String
  lang          String
  ownerUserId   String    @map("owner_user_id")
  ownerSchoolId String?   @map("owner_school_id")
  containerType String    @map("container_type")
  leafItemCount Int       @default(0) @map("leaf_item_count")
  deletedAt     DateTime? @map("deleted_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([ownerSchoolId])
  @@map("container_directory")
}

// ─── Projection: GroupDirectory ──────────────────────────────────────────────
// Built from school.group.published / school.group.archived events.
// Provides group metadata for student list responses.

model GroupDirectory {
  groupId   String    @id @map("group_id")
  schoolId  String    @map("school_id")
  name      String
  lang      String?
  level     String?
  courseId  String?   @map("course_id")
  status    String    // active | archived | draft
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("group_directory")
}

// ─── Projection: GroupMembership ─────────────────────────────────────────────
// Built from school.group.member.added / school.group.member.removed events.
// Used for unassigned-status derivation and student→group attribution.

model GroupMembership {
  id       String @id @default(uuid())
  groupId  String @map("group_id")
  schoolId String @map("school_id")
  userId   String @map("user_id")

  @@unique([groupId, userId])
  @@index([schoolId, userId])
  @@index([groupId])
  @@map("group_membership")
}

// ─── Projection: EnrollmentProjection ────────────────────────────────────────
// Built from learning.enrollment.* events + seed.
// Canonical set of active enrollments — basis for schoolStudents(S) and course-health.

model EnrollmentProjection {
  enrollmentId String    @id @map("enrollment_id")
  userId       String    @map("user_id")
  containerId  String    @map("container_id")
  schoolId     String?   @map("school_id")
  status       String    // ACTIVE | COMPLETED | UNENROLLED
  enrolledAt   DateTime  @map("enrolled_at")
  completedAt  DateTime? @map("completed_at")
  unenrolledAt DateTime? @map("unenrolled_at")

  @@index([userId])
  @@index([schoolId])
  @@index([containerId])
  @@index([schoolId, status])
  @@map("enrollment_projection")
}

// ─── Projection: ProgressActivity ─────────────────────────────────────────────
// Append-only log of learning activity events + seed.
// Used for active_students_7d counts, sparklines, and lastActivity (at-risk).
// schoolId is intentionally null — dashboard scopes via SchoolMembership.userId join.

model ProgressActivity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  contentType String   @map("content_type")
  contentId   String   @map("content_id")
  kind        String   // updated | completed
  occurredAt  DateTime @map("occurred_at")

  @@index([userId])
  @@index([userId, kind, occurredAt])
  @@index([occurredAt])
  @@map("progress_activity")
}

// ─── Audit: SchoolActivity ────────────────────────────────────────────────────
// Human-readable activity feed for the school dashboard.
// actorName is denormalized from UserDirectory at write time.
// Separate from metric projections — qualitative context, not counts.

model SchoolActivity {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  eventType  String   @map("event_type")
  tag        String   // people | content | review | milestone
  what       String
  target     String?
  targetId   String?  @map("target_id")
  occurredAt DateTime @map("occurred_at")

  @@index([schoolId, occurredAt(sort: Desc)])
  @@map("school_activity")
}

// ─── Projection: AttemptEvidence ──────────────────────────────────────────────
// Built from learning.attempt.rated (plan 36 §A.1). One row per attempt that
// actually moved an SRS card.
//
// This is a measurement table, not a dashboard one: it exists so the ceilings the
// evidence scale puts on ratings can be calibrated against what learners really do,
// and so "the scale works" can be told apart from "the scale broke the schedule".
// That only works if the rows predate the ceilings, which is why ratingApplied is
// recorded from the start, before anything clamps it.
//
// Deliberately absent: the learner's submitted answer. Right or wrong is enough to
// calibrate, and keeping the text would accumulate personal data for no purpose.

model AttemptEvidence {
  id           String   @id @default(uuid())
  eventId      String   @unique @map("event_id")
  userId       String   @map("user_id")
  exerciseId   String   @map("exercise_id")
  templateCode String?  @map("template_code")

  // Answer form, flattened from the event so it can be grouped on without JSON
  // extraction — the whole point of the table is grouping by form.
  answerMode    String? @map("answer_mode")    // bank | free
  bankSize      Int?    @map("bank_size")      // null in free mode: there is no bank
  wordsConsumed Boolean? @map("words_consumed")

  score  Int
  passed Boolean?

  attemptOrdinal      Int    @map("attempt_ordinal")
  daysSinceLastReview Float? @map("days_since_last_review")

  // Position within a consumed bank, for the decay in §B.3. Both stay null until
  // cards are per-gap (§C.1) — before that one card stands for the whole exercise.
  gapPosition Int? @map("gap_position")
  gapCount    Int? @map("gap_count")

  ratingApplied String   @map("rating_applied") // AGAIN | HARD | GOOD | EASY
  occurredAt    DateTime @map("occurred_at")

  // What the attempt exercised (plan 55 §3.6), flattened for the same reason the answer
  // form above is: the profile groups on these. Empty means the publisher said nothing —
  // every event from before the axes existed — and such a row belongs to no cell at all.
  skills String[] @default([])
  focus  String[] @default([])

  // FSRS stability after the review, in days. The one number that separates a learner who
  // forgets quickly from one who never knew: both produce a run of poor ratings, and only
  // the interval the schedule settled on says which.
  stabilityAfter Float? @map("stability_after")

  @@index([templateCode, answerMode, occurredAt])
  @@index([userId, occurredAt])
  @@map("attempt_evidence")
}

// ─── Projection: SrsLimitRefusal ──────────────────────────────────────────────
// Built from learning.srs.limit_refused (plan 37 §A.1). One row per time a daily
// SRS cap turned something down.
//
// The counterpart to attempt_evidence, and the reason it is a separate table: that
// one holds attempts that reached FSRS, so a refusal is by construction absent from
// it. Whether the caps of 20 and 200 are the right numbers is a question about the
// rows that are not there, and this table is where they go.
//
// Deliberately narrow: which cap, whose day, which kind of card. What the material
// was does not change the answer to a question about volume.

model SrsLimitRefusal {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  userId      String   @map("user_id")
  kind        String // new | review
  contentType String   @map("content_type") // EXERCISE | EXERCISE_GAP | VOCABULARY_WORD
  occurredAt  DateTime @map("occurred_at")

  @@index([kind, occurredAt])
  @@index([userId, occurredAt])
  @@map("srs_limit_refusals")
}
