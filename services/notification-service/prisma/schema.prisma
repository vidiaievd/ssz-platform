generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  WELCOME_EMAIL
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGED
  STUDY_REMINDER
  GENERAL
  TEACHER_ABSENCE
  SUBSTITUTE_REQUEST
  SUBSTITUTE_ASSIGNED
  OVERLOAD_ALERT
  VACANCY_ALERT
  UNCOVERED_LESSON
  SCHOOL_INVITATION
  TEACHER_PROFILE_CHANGED
  ENROLLMENT_REQUEST
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  PLACEMENT_REVIEW_READY
  GROUP_ASSIGNED
  ATTEMPT_REVIEWED
  REVIEW_DIGEST
  REVIEW_ESCALATION
  REVIEW_SCHOOL_SUMMARY

  @@map("notification_type")
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  PERMANENTLY_FAILED

  @@map("notification_status")
}

model Notification {
  id             String              @id @default(uuid())
  type           NotificationType
  channel        NotificationChannel @default(EMAIL)
  recipientId    String              @map("recipient_id")
  recipientEmail String?             @map("recipient_email")
  subject        String?
  templateKey    String              @map("template_key")
  templateData   Json                @default("{}") @map("template_data")
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3) @map("max_attempts")
  lastError      String?             @map("last_error")
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at")
  archivedAt     DateTime?           @map("archived_at")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([recipientId, archivedAt])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

/**
 * What each reviewer was last told about their queue (plan 47.5).
 * The row that keeps a digest from being a letter per submission: a learner who hands in
 * twelve exercises at one sitting must produce one message, and the next run must be able
 * to tell "twelve more arrived" from "the same twelve are still there".
 * `lastMaxSubmittedAt` is what answers that, and it is deliberately not a count: work
 * marked and work handed in between two runs can cancel out and leave the number where it
 * was, while the newest submission time only ever moves when something new arrives.
 */
model ReviewDigestState {
  userId             String    @id @map("user_id")
  lastSentAt         DateTime  @map("last_sent_at")
  lastMaxSubmittedAt DateTime  @map("last_max_submitted_at")
  /**
   * Separate clock: escalation is a daily question and must not be reset by a digest.
   */
  lastEscalatedAt    DateTime? @map("last_escalated_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("review_digest_state")
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
