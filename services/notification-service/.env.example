# Application
NODE_ENV=development
PORT=3005
LOG_LEVEL=debug

# Database
DATABASE_URL="postgresql://notifications_service:notifications_service_password@localhost:5432/notifications_db?schema=public"

# RabbitMQ
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672
RABBITMQ_EXCHANGE=ssz.events

# Redis (used by rate limiting / session guard in future)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword

# JWT (RS256 public key from Auth Service — replace \n with literal newline in production)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER="https://auth.ssz-platform.internal"
JWT_AUDIENCE="ssz-services"

# Email (SMTP)
# Local dev: MailHog on localhost:1025 (no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email sender identity
EMAIL_FROM_NAME=SSZ Platform
EMAIL_FROM_ADDRESS=noreply@ssz.local
