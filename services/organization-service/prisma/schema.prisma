generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  CONTENT_ADMIN
  TEACHER
  STUDENT
  SCHEDULER
}

enum EmploymentType {
  full
  part
  contract

  @@map("employment_type")
}

enum TeacherStatus {
  active
  invited
  inactive

  @@map("teacher_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SchoolType {
  ONLINE
  HYBRID
}

enum GroupStatus {
  draft
  active
  archived
}

enum GroupMode {
  online
  in_person
}

enum AgeBand {
  kids
  teens
  adults
}

enum GroupTeacherRole {
  primary
  co_primary
  substitute
}

enum GroupMemberRole {
  student
  trial
  observer

  @@map("group_member_role")
}

enum GroupMembershipStatus {
  active
  past

  @@map("group_membership_status")
}

enum StudentStatus {
  active
  archived

  @@map("student_status")
}

enum InvitationKind {
  register
  onboard_existing
}

model School {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  slug         String     @unique
  description  String?    @db.Text
  ownerId      String     // userId from user-profile-service — stays TEXT (external)
  avatarUrl    String?
  website      String?
  contactEmail String?    @map("contact_email")
  city         String?
  type         SchoolType @default(ONLINE)
  isActive     Boolean    @default(true)
  // School policies
  requireTutorReviewForSelfPaced Boolean @default(false)
  defaultExplanationLanguage     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  members             SchoolMember[]
  invitations         SchoolInvitation[]
  groups              SchoolGroup[]
  onboardingSettings  SchoolOnboardingSettings?
  memberships         SchoolMembership[]

  @@map("schools")
}

model SchoolMember {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @db.Uuid
  school    School     @relation(fields: [schoolId], references: [id])
  userId    String     // userId from user-profile-service — stays TEXT (external)
  role      MemberRole
  status    StudentStatus @default(active)  // meaningful for STUDENT role; archived = deactivated, not removed
  level     String?    // current CEFR level (A1–C2), STUDENT role only
  joinedAt  DateTime   @default(now())

  // Denormalized from user-profile-service (set at member-creation time, kept in
  // sync via profile.created/profile.updated RabbitMQ events). Avoids a live
  // profile-service call on every roster read. Null until first synced.
  name      String?
  avatarUrl String?

  teacherAttrs SchoolTeacher?
  permissions  SchoolMemberPermission?

  @@unique([schoolId, userId])
  @@index([userId])
  @@map("school_members")
}

// Rate-limit tracking for SD.7 individual nudge (max 1 per student per 24h).
model StudentNudge {
  schoolId     String   @map("school_id") @db.Uuid
  studentId    String   @map("student_id")
  lastNudgedAt DateTime @map("last_nudged_at")

  @@id([schoolId, studentId])
  @@map("student_nudges")
}

// One row per CEFR level period a student has held in a school. Closed (endedAt set)
// when level changes; latest open row (endedAt = null) is the student's current level.
model StudentLevelHistory {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  studentId  String    @map("student_id")           // external — stays TEXT
  level      String
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  groupId    String?   @map("group_id") @db.Uuid     // group context at the time level was set, if any
  assessedBy String?   @map("assessed_by")           // external userId of who set it, if any
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("student_level_history")
}

// Capability grants for MANAGER members (school-scoped).
// OWNER / ADMIN inherit all capabilities implicitly — no row needed.
model SchoolMemberPermission {
  schoolId     String       @map("school_id") @db.Uuid
  userId       String       @map("user_id")              // external — stays TEXT
  memberId     String       @unique @map("member_id") @db.Uuid
  member       SchoolMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  capabilities String[]     @default([])
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@id([schoolId, userId])
  @@map("school_member_permissions")
}

// Teacher-specific attributes (workload + availability windows) scoped per school.
// Linked to SchoolMember to ensure the user is actually a TEACHER in this school.
model SchoolTeacher {
  schoolId        String         @map("school_id") @db.Uuid
  userId          String         @map("user_id")           // external — stays TEXT
  memberId        String         @unique @map("member_id") @db.Uuid
  member          SchoolMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  maxWeeklyHours  Int?           @map("max_weekly_hours")
  availability    Json?          // [{ weekday: 1-7, start: "HH:mm", end: "HH:mm" }]
  employmentType  EmploymentType? @map("employment_type")
  status          TeacherStatus  @default(active)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  @@id([schoolId, userId])
  @@map("school_teachers")
}

model SchoolInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  schoolId      String           @db.Uuid
  school        School           @relation(fields: [schoolId], references: [id])
  email         String
  role          MemberRole       @default(TEACHER)
  kind          InvitationKind   @default(register)
  targetGroupId String?          @map("target_group_id") @db.Uuid
  invitedBy     String?          @map("invited_by")      // external — stays TEXT
  token         String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime         @map("expires_at")
  acceptedAt    DateTime?        @map("accepted_at")
  lastSentAt               DateTime         @default(now()) @map("last_sent_at")
  resendCount              Int              @default(0) @map("resend_count")
  firstName                String?          @map("first_name")
  lastName                 String?          @map("last_name")
  phone                    String?
  teacherMaxWeeklyHours    Int?             @map("teacher_max_weekly_hours")
  teacherEmploymentType    EmploymentType?  @map("teacher_employment_type")
  teacherLanguages         Json?            @map("teacher_languages")   // [{ code, level }] for role=TEACHER
  capabilities             String[]         @default([]) @map("capabilities")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([schoolId, status])
  @@index([schoolId, email, role])
  @@map("school_invitations")
}

model SchoolGroup {
  id          String      @id @default(uuid()) @db.Uuid
  schoolId    String      @map("school_id") @db.Uuid
  school      School      @relation(fields: [schoolId], references: [id])
  name        String
  description String?     @db.Text
  status      GroupStatus @default(draft)
  mode        GroupMode   @default(online)
  courseId    String?     @map("course_id")
  lang        String?     @db.Char(2)
  level       String?
  ageBand     AgeBand?    @map("age_band")
  capacityMin Int?        @map("capacity_min")
  capacityMax Int?        @map("capacity_max")
  startDate   DateTime?   @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  members   SchoolGroupMember[]
  teachers  GroupTeacher[]
  materials GroupMaterial[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("school_groups")
}

model SchoolGroupMember {
  id       String                @id @default(uuid()) @db.Uuid
  groupId  String                @map("group_id") @db.Uuid
  group    SchoolGroup           @relation(fields: [groupId], references: [id])
  userId   String                @map("user_id")    // external — stays TEXT
  role     GroupMemberRole       @default(student)
  status   GroupMembershipStatus @default(active)
  addedAt  DateTime              @default(now()) @map("added_at")
  exitedAt DateTime?             @map("exited_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
  @@map("school_group_members")
}

model GroupTeacher {
  id        String           @id @default(uuid()) @db.Uuid
  groupId   String           @map("group_id") @db.Uuid
  group     SchoolGroup      @relation(fields: [groupId], references: [id])
  userId    String           @map("user_id")    // external — stays TEXT
  role      GroupTeacherRole
  fromDate  DateTime?        @map("from_date") @db.Date
  toDate    DateTime?        @map("to_date") @db.Date
  reason    String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([groupId, userId, role])
  @@index([groupId])
  @@index([userId])
  @@map("group_teachers")
}

// Additional course materials attached to a group, distinct from the
// group's main material (school_groups.course_id) — see GroupMaterial vs
// SchoolGroup.courseId in school-group.entity.ts.
model GroupMaterial {
  id       String      @id @default(uuid()) @db.Uuid
  groupId  String      @map("group_id") @db.Uuid
  group    SchoolGroup @relation(fields: [groupId], references: [id])
  courseId String      @map("course_id")
  addedAt  DateTime    @default(now()) @map("added_at")

  @@unique([groupId, courseId])
  @@index([groupId])
  @@map("group_materials")
}

enum PlacementMode {
  platform
  school
  none

  @@map("placement_mode")
}

enum ApprovalMode {
  auto
  manual

  @@map("approval_mode")
}

model SchoolOnboardingSettings {
  schoolId           String       @id @map("school_id") @db.Uuid
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  placementMode      PlacementMode @default(platform) @map("placement_mode")
  schoolTestId       String?      @map("school_test_id") @db.Uuid
  reusePlatform      Boolean      @default(true) @map("reuse_platform")
  maxResultAgeDays   Int?         @map("max_result_age_days")
  interviewRequired  Boolean      @default(true) @map("interview_required")
  autoPlaceByScore   Boolean      @default(false) @map("auto_place_by_score")
  collectAvailability Boolean     @default(true) @map("collect_availability")
  ageBands           AgeBand[]    @default([]) @map("age_bands")
  collectAgeBand     Boolean      @default(false) @map("collect_age_band")
  approvalMode       ApprovalMode @default(manual) @map("approval_mode")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("school_onboarding_settings")
}

enum MembershipStatus {
  pending
  onboarding
  placement_review @map("placement-review")
  active
  rejected
  left

  @@map("membership_status")
}

enum MembershipSource {
  public_apply @map("public-apply")
  invite
  direct

  @@map("membership_source")
}

model SchoolMembership {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String           @map("student_id")
  status       MembershipStatus @default(pending)
  source       MembershipSource
  language     String?          @db.Char(2)
  availability Json?
  ageBand      AgeBand?         @map("age_band")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([studentId])
  @@map("school_memberships")
}

model TutoringGroup {
  id          String    @id @default(uuid()) @db.Uuid
  tutorId     String    @unique  // external tutor userId — stays TEXT
  name        String?
  description String?   @db.Text
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  students    TutoringStudent[]
  invitations TutoringInvitation[]

  @@map("tutoring_groups")
}

model TutoringStudent {
  id           String        @id @default(uuid()) @db.Uuid
  tutorGroupId String        @db.Uuid
  tutorGroup   TutoringGroup @relation(fields: [tutorGroupId], references: [id])
  userId       String        // external — stays TEXT
  joinedAt     DateTime      @default(now())

  @@unique([tutorGroupId, userId])
  @@map("tutoring_students")
}

model TutoringInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  tutorGroupId String           @map("tutor_group_id") @db.Uuid
  tutorGroup   TutoringGroup    @relation(fields: [tutorGroupId], references: [id])
  email        String
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  lastSentAt   DateTime         @default(now()) @map("last_sent_at")
  resendCount  Int              @default(0) @map("resend_count")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([tutorGroupId, status])
  @@map("tutoring_invitations")
}

// Idempotency guard for RabbitMQ event consumers
model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────
// Transactional outbox: events written atomically with the domain change.
// OutboxRelayService polls and publishes to RabbitMQ. See ADR-011.

model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String    @db.Text
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
