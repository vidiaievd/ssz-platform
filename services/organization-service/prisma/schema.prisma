generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  CONTENT_ADMIN
  TEACHER
  STUDENT
  SCHEDULER
}

enum EmploymentType {
  full
  part
  contract

  @@map("employment_type")
}

enum TeacherStatus {
  active
  invited
  inactive

  @@map("teacher_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum SchoolType {
  ONLINE
  HYBRID
}

enum GroupStatus {
  draft
  active
  archived
}

enum GroupMode {
  online
  in_person
}

enum GroupTeacherRole {
  primary
  co_primary
  substitute
}

enum InvitationKind {
  register
  onboard_existing
}

model School {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?    @db.Text
  ownerId      String     // userId from user-profile-service
  avatarUrl    String?
  website      String?
  contactEmail String?    @map("contact_email")
  city         String?
  type         SchoolType @default(ONLINE)
  isActive     Boolean    @default(true)
  // School policies
  requireTutorReviewForSelfPaced Boolean @default(false)
  defaultExplanationLanguage     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  members     SchoolMember[]
  invitations SchoolInvitation[]
  groups      SchoolGroup[]

  @@map("schools")
}

model SchoolMember {
  id        String     @id @default(uuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id])
  userId    String     // userId from user-profile-service
  role      MemberRole
  joinedAt  DateTime   @default(now())

  teacherAttrs SchoolTeacher?

  @@unique([schoolId, userId])
  @@map("school_members")
}

// Teacher-specific attributes (workload + availability windows) scoped per school.
// Linked to SchoolMember to ensure the user is actually a TEACHER in this school.
model SchoolTeacher {
  schoolId        String         @map("school_id")
  userId          String         @map("user_id")
  memberId        String         @unique @map("member_id")
  member          SchoolMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  maxWeeklyHours  Int?           @map("max_weekly_hours")
  availability    Json?          // [{ weekday: 1-7, start: "HH:mm", end: "HH:mm" }]
  employmentType  EmploymentType? @map("employment_type")
  status          TeacherStatus  @default(active)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  @@id([schoolId, userId])
  @@map("school_teachers")
}

model SchoolInvitation {
  id            String           @id @default(uuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id])
  email         String
  role          MemberRole       @default(TEACHER)
  kind          InvitationKind   @default(register)
  targetGroupId String?          @map("target_group_id")
  token         String           @unique  // signed JWT containing invitation metadata
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("school_invitations")
}

model SchoolGroup {
  id          String      @id @default(uuid())
  schoolId    String      @map("school_id")
  school      School      @relation(fields: [schoolId], references: [id])
  name        String
  description String?     @db.Text
  status      GroupStatus @default(draft)
  mode        GroupMode   @default(online)
  courseId    String?     @map("course_id")
  lang        String?     @db.Char(2)
  level       String?
  capacityMin Int?        @map("capacity_min")
  capacityMax Int?        @map("capacity_max")
  startDate   DateTime?   @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  members  SchoolGroupMember[]
  teachers GroupTeacher[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("school_groups")
}

model SchoolGroupMember {
  id       String      @id @default(uuid())
  groupId  String      @map("group_id")
  group    SchoolGroup @relation(fields: [groupId], references: [id])
  userId   String      @map("user_id")
  addedAt  DateTime    @default(now()) @map("added_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@map("school_group_members")
}

model GroupTeacher {
  id        String           @id @default(uuid())
  groupId   String           @map("group_id")
  group     SchoolGroup      @relation(fields: [groupId], references: [id])
  userId    String           @map("user_id")
  role      GroupTeacherRole
  fromDate  DateTime?        @map("from_date") @db.Date
  toDate    DateTime?        @map("to_date") @db.Date
  reason    String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([groupId, userId, role])
  @@index([groupId])
  @@index([userId])
  @@map("group_teachers")
}

model TutoringGroup {
  id          String    @id @default(uuid())
  tutorId     String    @unique  // one group per tutor
  name        String?
  description String?   @db.Text
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  students    TutoringStudent[]
  invitations TutoringInvitation[]

  @@map("tutoring_groups")
}

model TutoringStudent {
  id           String        @id @default(uuid())
  tutorGroupId String
  tutorGroup   TutoringGroup @relation(fields: [tutorGroupId], references: [id])
  userId       String
  joinedAt     DateTime      @default(now())

  @@unique([tutorGroupId, userId])
  @@map("tutoring_students")
}

model TutoringInvitation {
  id           String           @id @default(uuid())
  tutorGroupId String
  tutorGroup   TutoringGroup    @relation(fields: [tutorGroupId], references: [id])
  email        String
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("tutoring_invitations")
}

// Idempotency guard for RabbitMQ event consumers
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────
// Transactional outbox: events written atomically with the domain change.
// OutboxRelayService polls and publishes to RabbitMQ. See ADR-011.

model Outbox {
  id            String    @id @default(uuid())
  eventId       String    @unique @map("event_id")
  eventType     String    @map("event_type")
  exchange      String
  routingKey    String    @map("routing_key")
  payload       String    @db.Text
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
