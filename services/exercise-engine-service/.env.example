NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# Database (PostgreSQL — exercises_db)
DATABASE_URL=postgresql://exercise_engine_service:exercise_engine_service_password@localhost:5432/exercises_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdevpassword
REDIS_DB=5
REDIS_KEY_PREFIX=exercise-engine:

# RabbitMQ
RABBITMQ_URL=amqp://ssz_admin:localdevpassword@localhost:5672
RABBITMQ_EXCHANGE=ssz.events

# JWT — RS256 public key from Auth Service (PEM with literal \n)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=https://auth.ssz-platform.internal
JWT_AUDIENCE=ssz-services

# Downstream service base URLs
CONTENT_SERVICE_BASE_URL=http://localhost:3003
ORGANIZATION_SERVICE_BASE_URL=http://localhost:3002
LEARNING_SERVICE_BASE_URL=http://localhost:3007

# Shared secret for intra-cluster service-to-service calls
INTERNAL_SERVICE_TOKEN=change_me_in_production

# Seconds to cache exercise definitions in Redis (default 300 = 5 min)
EXERCISE_DEFINITION_CACHE_TTL_SECONDS=300
