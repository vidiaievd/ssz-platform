// Connection URL is configured in prisma.config.ts (Prisma 7).
// Run `npx prisma generate` after schema changes, `npx prisma migrate dev` to apply.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────
// Prisma enum names: SCREAMING_SNAKE_CASE  |  DB values: lowercase via @map

// Status lifecycle: IN_PROGRESS → SUBMITTED → SCORED (closed-form)
//                                           → ROUTED_FOR_REVIEW (free-form)
//                             ROUTED_FOR_REVIEW → SCORED   (teacher approved)
//                                               → RETURNED (teacher sent it back)
//                 IN_PROGRESS → ABANDONED
enum AttemptStatus {
  IN_PROGRESS       @map("in_progress")
  SUBMITTED         @map("submitted")
  SCORED            @map("scored")
  ROUTED_FOR_REVIEW @map("routed_for_review")
  RETURNED          @map("returned")
  ABANDONED         @map("abandoned")

  @@map("attempt_status")
}

// PRACTICE ships expectedAnswers for instant local checking; GRADED withholds them.
enum CheckMode {
  PRACTICE @map("practice")
  GRADED   @map("graded")

  @@map("check_mode")
}

// Mirrors Learning Service ContentType — kept in sync for forward-compat.
// Exercise Engine only uses EXERCISE in Sprint 5, but the full enum is declared
// so shared code (contracts package) can reference a single source of truth.
enum ContentType {
  CONTAINER       @map("container")
  LESSON          @map("lesson")
  VOCABULARY_LIST @map("vocabulary_list")
  GRAMMAR_RULE    @map("grammar_rule")
  EXERCISE        @map("exercise")

  @@map("content_type")
}

// CEFR difficulty levels — mirrors Content Service DifficultyLevel enum.
enum DifficultyLevel {
  A1 @map("a1")
  A2 @map("a2")
  B1 @map("b1")
  B2 @map("b2")
  C1 @map("c1")
  C2 @map("c2")

  @@map("difficulty_level")
}

// ─── Models ───────────────────────────────────────────────────────────────────

// One row per student exercise attempt.
// Closed-form attempts reach SCORED; free-form reach ROUTED_FOR_REVIEW.
// Fields marked // EVENT are included in exercise.attempt.completed payload —
// MUST match Learning Service's ExerciseAttemptedConsumer contract exactly.
model Attempt {
  id String @id @default(uuid())

  // EVENT — identifying fields published in exercise.attempt.completed
  userId     String @map("user_id")     // EVENT
  exerciseId String @map("exercise_id") // EVENT

  // Optional — present when attempt is linked to a tutor assignment or enrollment.
  assignmentId String? @map("assignment_id")
  enrollmentId String? @map("enrollment_id")

  // Exercise metadata snapshotted from Content Service at attempt start.
  templateCode    String          @map("template_code")
  targetLanguage  String          @map("target_language")
  difficultyLevel DifficultyLevel @map("difficulty_level")

  // Decided by the caller at start-attempt time; fixed for the attempt's lifetime —
  // governs whether expectedAnswers were shipped to the client and whether the
  // correct answer may be revealed in feedback.
  checkMode CheckMode @default(PRACTICE) @map("check_mode")

  // PRACTICED_BY atoms snapshotted from Content Service at attempt start —
  // Array<{atomType, atomId}>; fans out SRS rating to vocab/grammar atoms on scoring.
  practicedAtoms Json @default("[]") @map("practiced_atoms")

  status AttemptStatus @default(IN_PROGRESS)

  // EVENT — score and completion flag published in exercise.attempt.completed
  score  Int?  // EVENT: 0–100; null for free-form attempts
  passed Boolean? // derived from score >= passingThreshold; not published

  // EVENT — cumulative time across all addTimeSpent calls
  timeSpentSeconds Int @default(0) @map("time_spent_seconds") // EVENT

  // JSON payloads — shapes depend on template type, never leave infrastructure layer.
  submittedAnswer   Json? @map("submitted_answer")
  validationDetails Json? @map("validation_details")
  feedback          Json? // produced by IFeedbackGenerator

  // Answer hash for idempotency check on re-submission (SHA-256 of submittedAnswer JSON).
  answerHash String? @map("answer_hash")

  // Which resubmission of the same exercise this is after a RETURNED verdict —
  // attemptNo (plan 44 DATA_MODEL.md §1) is revisionCount + 1. Set from the
  // previous RETURNED attempt's count at start (see previousAttemptId below).
  revisionCount Int @default(0) @map("revision_count")

  // How many times the learner re-checked *this* attempt after seeing a score.
  // Deliberately separate from revisionCount: a re-check is the same work being
  // corrected with the wrong gaps on screen (only the first is evidence), while a
  // resubmission after a teacher returned it is new work that must count again.
  recheckCount Int @default(0) @map("recheck_count")

  // The learner asked to be shown the answers instead of working them out. A
  // separate action from being wrong, and recorded because it changes what the
  // attempt is evidence of — see docs/plan/36-srs-evidence-strength.md.
  answersRevealed Boolean @default(false) @map("answers_revealed")

  // How many self-checks the learner has spent on this attempt. The budget itself is
  // the exercise's (`flow.selfCheck`), not the attempt's — this only counts the
  // spending, so that a client cannot buy itself more by asking again.
  selfChecksUsed Int @default(0) @map("self_checks_used")

  // ── Work in progress ────────────────────────────────────────────────────
  // The unfinished answer, autosaved while the attempt is open, in the same
  // template-shaped JSON `submittedAnswer` will hold. Written for `writing_task`
  // (plan 50 phase 2), where a lost 200-word text is the worst thing this feature
  // can do to a student, but deliberately not typed to it: nothing here knows the
  // template, and the next runner that wants a crash-proof draft needs no migration.
  //
  // Not a second answer: it is never validated, never scored, and submitting reads
  // the body of the submit request, not this column.
  draftAnswer  Json?     @map("draft_answer")
  draftSavedAt DateTime? @map("draft_saved_at") @db.Timestamptz

  // ── Teacher review ──────────────────────────────────────────────────────
  // Free-form attempts stop at ROUTED_FOR_REVIEW, where the only verdict left is a
  // person's. What that person decided lives here.

  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz

  // The teacher's word to the learner about the submission as a whole.
  reviewComment String? @map("review_comment")

  // Per-item decisions: Array<{ itemId, approved, comment? }>. The templates that
  // reach review are sets of sentences, and "which one was not accepted" is the
  // feedback — a single verdict for the set would hide it.
  reviewDecisions Json? @map("review_decisions")

  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  scoredAt    DateTime? @map("scored_at")

  // ── Review context (plan 44) ────────────────────────────────────────────
  // Snapshotted at attempt start (see start-attempt.handler.ts) — the source
  // of truth for "who may review this" and "where does it show up" is
  // Organization/Content Service at that moment, not a live join later. All
  // nullable: a missing value means the attempt predates the migration, or
  // the owning service didn't answer — never a reason to fail the start.

  schoolId    String? @map("school_id") // null — attempt happened outside any school
  containerId String? @map("container_id") // top-level course the exercise sits in
  groupId     String? @map("group_id") // student's group at start; null → "no reviewer" in oversight

  // {course, module, exercise} titles as of attempt start — survives the
  // exercise/course being renamed or removed later (DATA_MODEL.md B/21).
  exercisePath Json? @map("exercise_path")

  // Soft "someone is looking at this" marker — expires 15 min after
  // reviewClaimedAt; no background job clears it, expiry is checked on read.
  reviewClaimedBy String?   @map("review_claimed_by")
  reviewClaimedAt DateTime? @map("review_claimed_at") @db.Timestamptz

  // The RETURNED attempt this one resubmits, if any — feeds attemptNo/`previous`.
  previousAttemptId String? @map("previous_attempt_id")

  // Snapshot of the validator's own tally at the moment the attempt routed
  // for review — a hint for the queue list, not the truth (§0.3): a single
  // verdict or batch-approve always recomputes the parse before acting.
  autoPassedItems Int? @map("auto_passed_items")
  totalItems      Int? @map("total_items")

  // ── Rubric grading (plan 50 §3.2) ───────────────────────────────────────
  // `writing_task` is not marked per item — a teacher sets one mark 0-3 per
  // rubric criterion, and the score is `Σ mark × weight` against
  // `settings.passScore`. Both columns are null for every other template.

  // What the teacher set: Record<criterionId, 0..3>. Written by the verdict,
  // never by the client's score — the client sends judgements, the server does
  // the arithmetic.
  rubricMarks Json? @map("rubric_marks")

  // The rubric as it stood when this submission reached the queue: criteria with
  // their weights and level descriptors, plus the pass threshold. Marks are
  // meaningless without the criteria they were set against, and an author editing
  // the rubric afterwards must not silently restate a past verdict
  // (IMPLEMENTATION.md, "Persistence").
  rubricSnapshot Json? @map("rubric_snapshot")

  @@index([userId, status])
  @@index([exerciseId])
  // The review queue: everything waiting on one exercise.
  @@index([exerciseId, status])
  @@index([assignmentId, status])
  @@index([userId, exerciseId, startedAt])
  // Oversight's own queue scoping (plan 44 §1).
  @@index([schoolId, status, submittedAt])
  @@index([groupId, status, submittedAt])
  @@index([containerId, status])
  // Decision journal and median-response-time aggregate.
  @@index([schoolId, reviewedAt])
  @@map("attempts")
}

// RabbitMQ consumer idempotency — one row per processed event.
// Consumers check this table before handling; insert on success.
// Shape is identical to Learning Service to allow shared documentation.
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
